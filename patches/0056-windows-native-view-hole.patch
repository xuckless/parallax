diff --git a/gpui-pre-windows/src/directx_renderer/native_view_tree.rs b/gpui-pre-windows/src/directx_renderer/native_view_tree.rs
new file mode 100644
index 0000000..4b69595
--- /dev/null
+++ b/gpui-pre-windows/src/directx_renderer/native_view_tree.rs
@@ -0,0 +1,68 @@
+//! The hole each native view shows through in GPUI's frame (docs/native-view-windows.md in Parallax), cleared in
+//! paint order as the Metal renderer's `native_views` pipeline does.
+
+use std::ops::Range;
+
+use anyhow::{Context as _, Result};
+use gpui::{Bounds, ScaledPixels, Scene};
+use windows::Win32::Graphics::Direct3D11::ID3D11Device;
+
+use super::{DirectXRenderer, PipelineState, create_opaque_blend_state, shader_resources::ShaderModule};
+
+/// The part of the swap chain a native view shows through: cleared to transparent in paint order, as the Metal
+/// renderer's `native_views` pipeline does, so elements painted after the view still cover it.
+#[derive(Clone, Copy)]
+#[repr(C)]
+pub(super) struct NativeViewHole {
+    bounds: Bounds<ScaledPixels>,
+    content_mask: Bounds<ScaledPixels>,
+}
+
+/// Writes with blending off at the batch's fixed depth, the depth test on, as every non-quad batch draws.
+pub(super) fn hole_pipeline(device: &ID3D11Device) -> Result<PipelineState<NativeViewHole>> {
+    PipelineState::new(
+        device,
+        "native_view_hole_pipeline",
+        ShaderModule::NativeView,
+        4,
+        create_opaque_blend_state(device)?,
+    )
+}
+
+impl DirectXRenderer {
+    pub(super) fn upload_native_view_holes(&mut self, scene: &Scene) -> Result<()> {
+        if scene.native_views.is_empty() {
+            return Ok(());
+        }
+        let devices = self.devices.as_ref().context("devices missing")?;
+        let holes: Vec<_> = scene
+            .native_views
+            .iter()
+            .map(|native_view| NativeViewHole {
+                bounds: native_view.bounds,
+                content_mask: native_view.content_mask.bounds,
+            })
+            .collect();
+        self.pipelines
+            .native_view_holes
+            .update_buffer(&devices.device, &devices.device_context, &holes)
+    }
+
+    /// Opaque quads painted after the view, which the opaque pass drew first, are nearer than the batch's depth and
+    /// keep their pixels; everything painted before it is erased.
+    pub(super) fn draw_native_view_holes(&mut self, range: Range<usize>) -> Result<()> {
+        if range.is_empty() {
+            return Ok(());
+        }
+        let devices = self.devices.as_ref().context("devices missing")?;
+        self.pipelines.native_view_holes.draw_range(
+            &devices.device_context,
+            self.globals
+                .batch_params_buffer
+                .as_ref()
+                .context("batch params buffer missing")?,
+            range.start as u32,
+            range.len() as u32,
+        )
+    }
+}
diff --git a/gpui-pre-windows/src/shaders.hlsl b/gpui-pre-windows/src/shaders.hlsl
index e849773..bdc868a 100644
--- a/gpui-pre-windows/src/shaders.hlsl
+++ b/gpui-pre-windows/src/shaders.hlsl
@@ -1370,3 +1370,29 @@ float4 polychrome_sprite_fragment(PolychromeSpriteFragmentInput input): SV_Targe
     color.a *= input.opacity * saturate(0.5 - distance);
     return color;
 }
+
+/*
+**
+**              Native views
+**
+*/
+
+struct NativeViewHole {
+    Bounds bounds;
+    Bounds content_mask;
+};
+
+StructuredBuffer<NativeViewHole> native_view_holes: register(t1);
+
+float4 native_view_vertex(uint vertex_id: SV_VertexID, uint instance_id: SV_InstanceID): SV_Position {
+    float2 unit_vertex = float2(float(vertex_id & 1u), 0.5 * float(vertex_id & 2u));
+    NativeViewHole hole = native_view_holes[batch_start_index + instance_id];
+    ClippedVertex vertex = clip_to_mask(unit_vertex, hole.bounds, hole.content_mask);
+    return to_device_position_impl(vertex.position);
+}
+
+// The pipeline does not blend, so this erases what was drawn beneath the view, as the Metal renderer's
+// native_view_fragment does.
+float4 native_view_fragment(float4 position: SV_Position): SV_Target {
+    return float4(0.0, 0.0, 0.0, 0.0);
+}
