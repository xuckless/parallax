@@ -0,0 +1,111 @@
+//! Where a native view's container and view go in the window: gpui_macos's
+//! `Placement` (window/native_views.rs) without AppKit's flipped y. Pure, so
+//! scripts/patch-test.sh runs its tests on the host (`ios-pure`).
+
+use gpui::{Bounds, ScaledPixels};
+
+/// Where a native view is shown, as `[x, y, width, height]` frames in points.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) struct Placement {
+    /// The visible part of the view, in GPUI's view's superview.
+    pub(super) container: [f64; 4],
+    /// The whole view, in its container.
+    pub(super) view: [f64; 4],
+}
+
+impl Placement {
+    /// Places a view with the given bounds and clip, both in device pixels
+    /// from the top left of GPUI's view, whose origin in the window is
+    /// `gpui_origin`. Returns `None` if the clip leaves none of the view visible.
+    pub(super) fn new(
+        bounds: Bounds<ScaledPixels>,
+        content_mask: Bounds<ScaledPixels>,
+        scale_factor: f64,
+        gpui_origin: [f64; 2],
+    ) -> Option<Self> {
+        let visible = bounds.intersect(&content_mask);
+        if visible.is_empty() {
+            return None;
+        }
+        let to_frame = |bounds: Bounds<ScaledPixels>| {
+            let to_points = |value: ScaledPixels| f64::from(value) / scale_factor;
+            [
+                gpui_origin[0] + to_points(bounds.origin.x),
+                gpui_origin[1] + to_points(bounds.origin.y),
+                to_points(bounds.size.width),
+                to_points(bounds.size.height),
+            ]
+        };
+        let container = to_frame(visible);
+        let [x, y, width, height] = to_frame(bounds);
+        Some(Self {
+            container,
+            view: [x - container[0], y - container[1], width, height],
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use gpui::{point, size};
+
+    #[test]
+    fn placement_clips_a_view_to_its_content_mask() {
+        let bounds = |x: f32, y: f32, width: f32, height: f32| Bounds {
+            origin: point(ScaledPixels(x), ScaledPixels(y)),
+            size: size(ScaledPixels(width), ScaledPixels(height)),
+        };
+        // (name, bounds, content mask, scale, GPUI origin, placement)
+        let cases = [
+            (
+                "unclipped at 2x",
+                bounds(20., 40., 200., 100.),
+                bounds(0., 0., 1000., 1000.),
+                2.,
+                [0., 0.],
+                Some(Placement {
+                    container: [10., 20., 100., 50.],
+                    view: [0., 0., 100., 50.],
+                }),
+            ),
+            (
+                "clipped on the top left at 3x",
+                bounds(0., 0., 300., 300.),
+                bounds(30., 60., 600., 600.),
+                3.,
+                [0., 0.],
+                Some(Placement {
+                    container: [10., 20., 90., 80.],
+                    view: [-10., -20., 100., 100.],
+                }),
+            ),
+            (
+                "GPUI's view offset in the window",
+                bounds(0., 0., 100., 100.),
+                bounds(0., 0., 100., 100.),
+                1.,
+                [5., 7.],
+                Some(Placement {
+                    container: [5., 7., 100., 100.],
+                    view: [0., 0., 100., 100.],
+                }),
+            ),
+            (
+                "clipped away",
+                bounds(0., 0., 100., 100.),
+                bounds(200., 200., 10., 10.),
+                1.,
+                [0., 0.],
+                None,
+            ),
+        ];
+        for (name, bounds, mask, scale, origin, placement) in cases {
+            assert_eq!(
+                Placement::new(bounds, mask, scale, origin),
+                placement,
+                "{name}"
+            );
+        }
+    }
+}
