+// Ported from flutter/flutter packages/flutter/lib/src/gestures/events.dart @ 3.50.1
+// (ae9b586f34a8443573f82ef57c3bf914a908cbf7) (computeHitSlop, computePanSlop, computeScaleSlop, and
