diff --git a/gpui-pre/src/gestures/constants.rs b/gpui-pre/src/gestures/constants.rs
new file mode 100644
index 0000000..8addabb
--- /dev/null
+++ b/gpui-pre/src/gestures/constants.rs
@@ -0,0 +1,119 @@
+// Ported from flutter/flutter packages/flutter/lib/src/gestures/constants.dart @ 3.50.1
+// (ae9b586f34a8443573f82ef57c3bf914a908cbf7). Copyright 2014 The Flutter Authors. BSD-3-Clause, see
+// third_party/flutter/LICENSE.
+//
+// Flutter's names are kept so its changes diff in. Distances are logical pixels (`Pixels`), velocities logical
+// pixels per second. Dropped: nothing.
+
+//! Flutter's gesture constants, the one copy GPUI's recognizers and Parallax's platform behaviour table read.
+
+#![allow(
+    non_upper_case_globals,
+    reason = "Flutter's constant names, kept so Flutter changes diff in"
+)]
+
+use std::time::Duration;
+
+use crate::{Pixels, px};
+
+// Modeled after Android's ViewConfiguration:
+// https://github.com/android/platform_frameworks_base/blob/main/core/java/android/view/ViewConfiguration.java
+
+/// The time that must elapse before a tap gesture sends onTapDown, if there's
+/// any doubt that the gesture is a tap.
+pub const kPressTimeout: Duration = Duration::from_millis(100);
+
+/// Maximum length of time between a tap down and a tap up for the gesture to be
+/// considered a tap. (Currently not honored by the TapGestureRecognizer.)
+// TODO(ianh): Remove this, or implement a hover-tap gesture recognizer which
+// uses this.
+pub const kHoverTapTimeout: Duration = Duration::from_millis(150);
+
+/// Maximum distance between the down and up pointers for a tap. (Currently not
+/// honored by the TapGestureRecognizer; PrimaryPointerGestureRecognizer,
+/// which TapGestureRecognizer inherits from, uses [`kTouchSlop`].)
+// TODO(ianh): Remove this or implement it correctly.
+pub const kHoverTapSlop: Pixels = px(20.0); // Logical pixels
+
+/// The time before a long press gesture attempts to win.
+pub const kLongPressTimeout: Duration = Duration::from_millis(500);
+
+/// The maximum time from the start of the first tap to the start of the second
+/// tap in a double-tap gesture.
+// In Android, this is actually the time from the first's up event
+// to the second's down event, according to the ViewConfiguration docs.
+pub const kDoubleTapTimeout: Duration = Duration::from_millis(300);
+
+/// The minimum time from the end of the first tap to the start of the second
+/// tap in a double-tap gesture.
+pub const kDoubleTapMinTime: Duration = Duration::from_millis(40);
+
+/// The maximum distance that the first touch in a double-tap gesture can travel
+/// before deciding that it is not part of a double-tap gesture.
+/// DoubleTapGestureRecognizer also restricts the second touch to this distance.
+pub const kDoubleTapTouchSlop: Pixels = kTouchSlop; // Logical pixels
+
+/// Distance between the initial position of the first touch and the start
+/// position of a potential second touch for the second touch to be considered
+/// the second touch of a double-tap gesture.
+pub const kDoubleTapSlop: Pixels = px(100.0); // Logical pixels
+
+/// The time for which zoom controls (e.g. in a map interface) are to be
+/// displayed on the screen, from the moment they were last requested.
+pub const kZoomControlsTimeout: Duration = Duration::from_millis(3000);
+
+/// The distance a touch has to travel for the framework to be confident that
+/// the gesture is a scroll gesture, or, inversely, the maximum distance that a
+/// touch can travel before the framework becomes confident that it is not a
+/// tap.
+///
+/// A total delta less than or equal to [`kTouchSlop`] is not considered to be a
+/// drag, whereas if the delta is greater than [`kTouchSlop`] it is considered to
+/// be a drag.
+// This value was empirically derived. We started at 8.0 and increased it to
+// 18.0 after getting complaints that it was too difficult to hit targets.
+pub const kTouchSlop: Pixels = px(18.0); // Logical pixels
+
+/// The distance a touch has to travel for the framework to be confident that
+/// the gesture is a paging gesture. (Currently not used, because paging uses a
+/// regular drag gesture, which uses kTouchSlop.)
+// TODO(ianh): Create variants of HorizontalDragGestureRecognizer et al for
+// paging, which use this constant.
+pub const kPagingTouchSlop: Pixels = px(kTouchSlop.0 * 2.0); // Logical pixels
+
+/// The distance a touch has to travel for the framework to be confident that
+/// the gesture is a panning gesture.
+pub const kPanSlop: Pixels = px(kTouchSlop.0 * 2.0); // Logical pixels
+
+/// The distance a touch has to travel for the framework to be confident that
+/// the gesture is a scale gesture.
+pub const kScaleSlop: Pixels = kTouchSlop; // Logical pixels
+
+/// The margin around a dialog, popup menu, or other window-like widget inside
+/// which we do not consider a tap to dismiss the widget. (Not currently used.)
+// TODO(ianh): Make ModalBarrier support this.
+pub const kWindowTouchSlop: Pixels = px(16.0); // Logical pixels
+
+/// The minimum velocity for a touch to consider that touch to trigger a fling
+/// gesture.
+// TODO(ianh): Make sure nobody has their own version of this.
+pub const kMinFlingVelocity: f32 = 50.0; // Logical pixels / second
+// const Velocity kMinFlingVelocity = const Velocity(pixelsPerSecond: 50.0);
+
+/// Drag gesture fling velocities are clipped to this value.
+// TODO(ianh): Make sure nobody has their own version of this.
+pub const kMaxFlingVelocity: f32 = 8000.0; // Logical pixels / second
+
+/// The maximum time from the start of the first tap to the start of the second
+/// tap in a jump-tap gesture.
+// TODO(ianh): Implement jump-tap gestures.
+pub const kJumpTapTimeout: Duration = Duration::from_millis(500);
+
+/// Like [`kTouchSlop`], but for more precise pointers like mice and trackpads.
+pub const kPrecisePointerHitSlop: Pixels = px(1.0); // Logical pixels;
+
+/// Like [`kPanSlop`], but for more precise pointers like mice and trackpads.
+pub const kPrecisePointerPanSlop: Pixels = px(kPrecisePointerHitSlop.0 * 2.0); // Logical pixels
+
+/// Like [`kScaleSlop`], but for more precise pointers like mice and trackpads.
+pub const kPrecisePointerScaleSlop: Pixels = kPrecisePointerHitSlop; // Logical pixels
diff --git a/gpui-pre/src/gestures/recognizer_tests.rs b/gpui-pre/src/gestures/recognizer_tests.rs
new file mode 100644
index 0000000..54ed332
--- /dev/null
+++ b/gpui-pre/src/gestures/recognizer_tests.rs
@@ -0,0 +1,884 @@
+// Ported from flutter/flutter packages/flutter/test/gestures/tap_test.dart, double_tap_test.dart,
+// long_press_test.dart and drag_test.dart @ 3.50.1 (ae9b586f34a8443573f82ef57c3bf914a908cbf7).
+// Copyright 2014 The Flutter Authors. BSD-3-Clause, see third_party/flutter/LICENSE.
+
+//! Flutter's recognizer tests as the oracle for the touch recognizer, driven
+//! through the test platform: a recorded touch trace goes into a window, the
+//! gestures the window dispatches come out. One row per Flutter test; its name
+//! is the row's. Flutter's arena (`closeArena`, `sweep`) has no counterpart:
+//! the recognizer resolves a touch by claims.
+
+use std::{cell::RefCell, rc::Rc, time::Duration};
+
+use scheduler::Instant;
+
+use crate::{
+    App, Bounds, Context, DispatchPhase, GestureTuning, HitboxBehavior, InputEvent as _,
+    IntoElement, LongPressEvent, MouseDownEvent, Pixels, PointerDevice, Render, ScrollDelta,
+    ScrollEvent, TestAppContext, TouchDragEvent, TouchEvent, TouchId, TouchPhase, Window, canvas,
+    point, px, size,
+};
+
+use TouchPhase::{Cancelled, Ended, Moved, Started};
+
+/// One touch event of a recorded trace: what the platform reported, and when,
+/// in milliseconds from the trace's start. Wave 12's recorder emits these.
+#[derive(Clone, Copy)]
+pub(crate) struct TraceEvent {
+    pub(crate) at_ms: u64,
+    id: u64,
+    phase: TouchPhase,
+    x: f32,
+    y: f32,
+}
+
+pub(crate) const fn touch(at_ms: u64, id: u64, phase: TouchPhase, x: f32, y: f32) -> TraceEvent {
+    TraceEvent {
+        at_ms,
+        id,
+        phase,
+        x,
+        y,
+    }
+}
+
+/// A gesture the window dispatched, as the element under the touch saw it.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Seen {
+    /// A tap's synthesized press, with its click count: 2 is a double tap.
+    Tap(usize),
+    /// A pan step: its phase and scroll delta.
+    Scroll(TouchPhase, f32, f32),
+    /// A claimed long press: its phase and the touch's position.
+    LongPress(TouchPhase, f32, f32),
+    /// A claimed touch drag: its phase and the touch's position.
+    TouchDrag(TouchPhase, f32, f32),
+}
+
+use Seen::{LongPress, Scroll, Tap, TouchDrag};
+
+/// What the element claims, standing in for the recognizer the Flutter test
+/// builds. Taps and pans are always recognized; a long press or touch drag
+/// only reaches an element that claims it.
+#[derive(Clone, Copy)]
+enum Claim {
+    Nothing,
+    LongPress,
+    TouchDrag,
+}
+
+struct Row<'a> {
+    name: &'static str,
+    tuning: GestureTuning,
+    claim: Claim,
+    /// Hitboxes the element inserts: what a tap lands on (none: every tap
+    /// lands on nothing, the same target).
+    targets: &'a [Bounds<Pixels>],
+    trace: &'a [TraceEvent],
+    /// The clock runs on to here after the trace, for timers still pending.
+    until_ms: u64,
+    /// Each gesture with when it was dispatched, in milliseconds.
+    expected: &'a [(u64, Seen)],
+}
+
+struct Recorder {
+    claim: Claim,
+    targets: Vec<Bounds<Pixels>>,
+    started_at: Instant,
+    seen: Rc<RefCell<Vec<(u64, Seen)>>>,
+}
+
+impl Render for Recorder {
+    fn render(&mut self, _: &mut Window, _: &mut Context<Self>) -> impl IntoElement {
+        let (seen, started_at, claim) = (self.seen.clone(), self.started_at, self.claim);
+        let targets = self.targets.clone();
+        let record = move |cx: &App, gesture| {
+            let at = cx.background_executor().now().duration_since(started_at);
+            seen.borrow_mut().push((at.as_millis() as u64, gesture));
+        };
+        canvas(
+            move |_, window, _| {
+                for bounds in targets {
+                    window.insert_hitbox(bounds, HitboxBehavior::Normal);
+                }
+            },
+            move |_, _, window, _| {
+                let on_tap = record.clone();
+                window.on_mouse_event(move |event: &MouseDownEvent, phase, _, cx| {
+                    if phase == DispatchPhase::Bubble {
+                        on_tap(cx, Tap(event.click_count));
+                    }
+                });
+                let on_scroll = record.clone();
+                window.on_mouse_event(move |event: &ScrollEvent, phase, _, cx| {
+                    let ScrollDelta::Pixels(delta) = event.delta else {
+                        return;
+                    };
+                    if phase == DispatchPhase::Bubble {
+                        on_scroll(
+                            cx,
+                            Scroll(event.touch_phase, delta.x.into(), delta.y.into()),
+                        );
+                    }
+                });
+                match claim {
+                    Claim::Nothing => {}
+                    Claim::LongPress => {
+                        window.on_mouse_event(move |event: &LongPressEvent, phase, window, cx| {
+                            if phase != DispatchPhase::Bubble {
+                                return;
+                            }
+                            let at = event.position;
+                            record(cx, LongPress(event.phase, at.x.into(), at.y.into()));
+                            window.prevent_default();
+                        })
+                    }
+                    Claim::TouchDrag => {
+                        window.on_mouse_event(move |event: &TouchDragEvent, phase, window, cx| {
+                            if phase != DispatchPhase::Bubble {
+                                return;
+                            }
+                            let at = event.position;
+                            record(cx, TouchDrag(event.phase, at.x.into(), at.y.into()));
+                            window.prevent_default();
+                        })
+                    }
+                }
+            },
+        )
+    }
+}
+
+/// Replays `row.trace` into a fresh window and returns what it dispatched.
+fn replay(row: &Row, cx: &mut TestAppContext) -> Vec<(u64, Seen)> {
+    let seen = Rc::new(RefCell::new(Vec::new()));
+    let started_at = cx.executor().now();
+    let window = cx.add_window({
+        let seen = seen.clone();
+        let claim = row.claim;
+        let targets = row.targets.to_vec();
+        move |_, _| Recorder {
+            claim,
+            targets,
+            started_at,
+            seen,
+        }
+    });
+    let tuning = row.tuning;
+    window
+        .update(cx, |_, window, _| window.set_gesture_tuning(tuning))
+        .unwrap();
+    let trace = row.trace.iter().map(|event| event.to_timed_input());
+    crate::play_trace(cx, window.into(), trace, None, row.until_ms, |_, _, _| {});
+    seen.take()
+}
+
+impl TraceEvent {
+    /// The platform event this trace event replays.
+    pub(crate) fn to_touch_event(self) -> TouchEvent {
+        TouchEvent {
+            id: TouchId(self.id),
+            phase: self.phase,
+            position: point(px(self.x), px(self.y)),
+            predicted_position: None,
+            force: None,
+            device: PointerDevice::Touch,
+        }
+    }
+
+    /// The event as [`crate::play_trace`] input: its time and the platform input.
+    pub(crate) fn to_timed_input(self) -> (u64, crate::PlatformInput) {
+        (self.at_ms, self.to_touch_event().to_platform_input())
+    }
+}
+
+/// Two side-by-side tap targets for the per-target rows.
+const BUTTON_A: Bounds<Pixels> = Bounds {
+    origin: point(px(0.), px(0.)),
+    size: size(px(50.), px(50.)),
+};
+const BUTTON_B: Bounds<Pixels> = Bounds {
+    origin: point(px(60.), px(0.)),
+    size: size(px(50.), px(50.)),
+};
+
+#[crate::test]
+fn flutter_recognizer_tests_pass(cx: &mut TestAppContext) {
+    // Flutter's constants.dart values, which every row starts from.
+    let flutter = GestureTuning::default();
+    let rows = [
+        // tap_test.dart. down1/up1 at (10, 10)/(11, 9); down2/up2 at (30, 30)/(31, 29).
+        Row {
+            name: "Should recognize tap",
+            tuning: flutter,
+            claim: Claim::Nothing,
+            targets: &[],
+            trace: &[touch(0, 1, Started, 10., 10.), touch(0, 1, Ended, 11., 9.)],
+            until_ms: 0,
+            expected: &[(0, Tap(1))],
+        },
+        Row {
+            // Two taps, the second within kDoubleTapMinTime: not a double tap.
+            name: "No duplicate tap events",
+            tuning: flutter,
+            claim: Claim::Nothing,
+            targets: &[],
+            trace: &[
+                touch(0, 1, Started, 10., 10.),
+                touch(0, 1, Ended, 11., 9.),
+                touch(0, 1, Started, 10., 10.),
+                touch(0, 1, Ended, 11., 9.),
+            ],
+            until_ms: 0,
+            expected: &[(0, Tap(1)), (0, Tap(1))],
+        },
+        Row {
+            name: "Should not recognize two overlapping taps (FIFO)",
+            tuning: flutter,
+            claim: Claim::Nothing,
+            targets: &[],
+            trace: &[
+                touch(0, 1, Started, 10., 10.),
+                touch(0, 2, Started, 30., 30.),
+                touch(0, 1, Ended, 11., 9.),
+                touch(0, 2, Ended, 31., 29.),
+            ],
+            until_ms: 0,
+            expected: &[(0, Tap(1))],
+        },
+        Row {
+            name: "Should not recognize two overlapping taps (FILO)",
+            tuning: flutter,
+            claim: Claim::Nothing,
+            targets: &[],
+            trace: &[
+                touch(0, 1, Started, 10., 10.),
+                touch(0, 2, Started, 30., 30.),
+                touch(0, 2, Ended, 31., 29.),
+                touch(0, 1, Ended, 11., 9.),
+            ],
+            until_ms: 0,
+            expected: &[(0, Tap(1))],
+        },
+        Row {
+            // Moves ~21 px, more than kTouchSlop: a pan, never a tap.
+            name: "Distance cancels tap",
+            tuning: flutter,
+            claim: Claim::Nothing,
+            targets: &[],
+            trace: &[
+                touch(0, 3, Started, 10., 10.),
+                touch(0, 3, Moved, 25., 25.),
+                touch(0, 3, Ended, 25., 25.),
+            ],
+            until_ms: 0,
+            expected: &[(0, Scroll(Started, 0., 15.)), (0, Scroll(Ended, 0., 0.))],
+        },
+        Row {
+            // Moves ~17 px, less than kTouchSlop.
+            name: "Short distance does not cancel tap",
+            tuning: flutter,
+            claim: Claim::Nothing,
+            targets: &[],
+            trace: &[
+                touch(0, 4, Started, 10., 10.),
+                touch(0, 4, Moved, 22., 22.),
+                touch(0, 4, Ended, 22., 22.),
+            ],
+            until_ms: 0,
+            expected: &[(0, Tap(1))],
+        },
+        Row {
+            name: "Timeout does not cancel tap",
+            tuning: flutter,
+            claim: Claim::Nothing,
+            targets: &[],
+            trace: &[
+                touch(0, 1, Started, 10., 10.),
+                touch(500, 1, Ended, 11., 9.),
+            ],
+            until_ms: 500,
+            expected: &[(500, Tap(1))],
+        },
+        Row {
+            name: "PointerCancelEvent cancels tap",
+            tuning: flutter,
+            claim: Claim::Nothing,
+            targets: &[],
+            trace: &[
+                touch(0, 5, Started, 10., 10.),
+                touch(5000, 5, Cancelled, 10., 10.),
+            ],
+            until_ms: 5000,
+            expected: &[],
+        },
+        Row {
+            name: "PointerCancelEvent after exceeding deadline cancels tap",
+            tuning: flutter,
+            claim: Claim::Nothing,
+            targets: &[],
+            trace: &[
+                touch(0, 5, Started, 10., 10.),
+                touch(1000, 5, Cancelled, 10., 10.),
+            ],
+            until_ms: 1000,
+            expected: &[],
+        },
+        Row {
+            name: "losing tap gesture recognizer does not send onTapCancel",
+            tuning: flutter,
+            claim: Claim::Nothing,
+            targets: &[],
+            trace: &[touch(0, 3, Started, 10., 10.), touch(0, 3, Moved, 25., 25.)],
+            until_ms: 0,
+            expected: &[(0, Scroll(Started, 0., 15.))],
+        },
+        Row {
+            name: "non-primary pointers does not trigger timeout",
+            tuning: flutter,
+            claim: Claim::Nothing,
+            targets: &[],
+            trace: &[
+                touch(0, 1, Started, 10., 10.),
+                touch(0, 2, Started, 30., 30.),
+                touch(0, 1, Ended, 11., 9.),
+                touch(200, 2, Ended, 31., 29.),
+            ],
+            until_ms: 200,
+            expected: &[(0, Tap(1))],
+        },
+        Row {
+            name: "A second tap after rejection is ignored",
+            tuning: flutter,
+            claim: Claim::Nothing,
+            targets: &[],
+            trace: &[
+                touch(0, 1, Started, 0., 0.),
+                touch(0, 1, Moved, 50., 0.),
+                touch(0, 2, Started, 10., 20.),
+            ],
+            until_ms: 0,
+            expected: &[(0, Scroll(Started, 50., 0.))],
+        },
+        // double_tap_test.dart. down1/up1 (10, 10)/(11, 9); down2/up2 (12, 12)/(13, 11);
+        // down3/up3 (130, 130)/(131, 129); down4/move4/up4 (10, 10)/(25, 25)/(25, 25);
+        // down5/up5 as down1/up1.
+        Row {
+            name: "Should recognize double tap",
+            tuning: flutter,
+            claim: Claim::Nothing,
+            targets: &[],
+            trace: &[
+                touch(0, 1, Started, 10., 10.),
+                touch(0, 1, Ended, 11., 9.),
+                touch(100, 2, Started, 12., 12.),
+                touch(100, 2, Ended, 13., 11.),
+            ],
+            until_ms: 100,
+            expected: &[(0, Tap(1)), (100, Tap(2))],
+        },
+        Row {
+            name: "Inter-tap distance cancels double tap",
+            tuning: flutter,
+            claim: Claim::Nothing,
+            targets: &[],
+            trace: &[
+                touch(0, 1, Started, 10., 10.),
+                touch(0, 1, Ended, 11., 9.),
+                touch(0, 3, Started, 130., 130.),
+                touch(0, 3, Ended, 131., 129.),
+            ],
+            until_ms: 0,
+            expected: &[(0, Tap(1)), (0, Tap(1))],
+        },
+        Row {
+            name: "Intra-tap distance cancels double tap",
+            tuning: flutter,
+            claim: Claim::Nothing,
+            targets: &[],
