+// Ported from flutter/flutter packages/flutter/lib/src/physics/{tolerance,simulation,friction_simulation}.dart
+// and packages/flutter/lib/src/widgets/scroll_simulation.dart @ ae9b586f34a8443573f82ef57c3bf914a908cbf7 (3.50.1).
+// Copyright 2014 The Flutter Authors. BSD-3-Clause, see third_party/flutter/LICENSE.
+
+//! The fling simulations behind [`ScrollPhysics`](super::ScrollPhysics),
+//! translated from Flutter: [`FrictionSimulation`] (iOS) and
+//! [`ClampingScrollSimulation`] (Android). Times are in seconds, positions
+//! in pixels, velocities in pixels per second.
+
+/// Structure that specifies maximum allowable magnitudes for distances,
+/// durations, and velocity differences to be considered equal.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Tolerance {
+    /// The magnitude of the maximum distance between two points for them to be
+    /// considered within tolerance.
+    pub distance: f64,
+    /// The magnitude of the maximum duration between two times for them to be
+    /// considered within tolerance.
+    pub time: f64,
+    /// The magnitude of the maximum difference between two velocities for them to
+    /// be considered within tolerance.
+    pub velocity: f64,
+}
+
+impl Tolerance {
+    const EPSILON_DEFAULT: f64 = 1e-3;
+
+    /// A default tolerance of 0.001 for all three values.
+    pub const DEFAULT_TOLERANCE: Tolerance = Tolerance {
+        distance: Self::EPSILON_DEFAULT,
+        time: Self::EPSILON_DEFAULT,
+        velocity: Self::EPSILON_DEFAULT,
+    };
+}
+
+/// The base class for all simulations.
+///
+/// A simulation models an object, in a one-dimensional space, on which particular
+/// forces are being applied, and exposes:
+///
+///  * The object's position, [`Simulation::x`]
+///  * The object's velocity, [`Simulation::dx`]
+///  * Whether the simulation is "done", [`Simulation::is_done`]
+///
+/// A simulation is generally "done" if the object has, to a given tolerance,
+/// come to a complete rest.
+pub trait Simulation {
+    /// The position of the object in the simulation at the given time.
+    fn x(&self, time: f64) -> f64;
+    /// The velocity of the object in the simulation at the given time.
+    fn dx(&self, time: f64) -> f64;
+    /// Whether the simulation is "done" at the given time.
+    fn is_done(&self, time: f64) -> bool;
+}
+
+/// Numerically determine the input value which produces output value `target`
+/// for a function `f`, given its first-derivative `df`.
+fn newtons_method(
+    initial_guess: f64,
+    target: f64,
+    f: impl Fn(f64) -> f64,
+    df: impl Fn(f64) -> f64,
+    iterations: usize,
+) -> f64 {
+    let mut guess = initial_guess;
+    for _ in 0..iterations {
+        guess -= (f(guess) - target) / df(guess);
+    }
+    guess
+}
+
+/// A simulation that applies a drag to slow a particle down.
+///
+/// Models a particle affected by fluid drag, e.g. air resistance.
+///
+/// The simulation ends when the velocity of the particle drops to zero (within
+/// the current velocity tolerance).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct FrictionSimulation {
+    drag: f64,
+    drag_log: f64,
+    x: f64,
+    v: f64,
+    constant_deceleration: f64,
+    // The time at which the simulation should be stopped.
+    // This is needed when constantDeceleration is not zero (on Desktop), when
+    // using the pure friction simulation, acceleration naturally reduces to zero
+    // and creates a stopping point.
+    final_time: f64,
+    /// How close to the actual end of the simulation a value at a particular time
+    /// must be before [`Simulation::is_done`] considers the simulation to be "done".
+    pub tolerance: Tolerance,
+}
+
+impl FrictionSimulation {
+    /// Creates a [`FrictionSimulation`] with the given arguments, namely: the fluid
+    /// drag coefficient _cₓ_, a unitless value; the initial position _x₀_, in the same
+    /// length units as used for [`Simulation::x`]; and the initial velocity _dx₀_, in the same
+    /// velocity units as used for [`Simulation::dx`].
+    pub fn new(
+        drag: f64,
+        position: f64,
+        velocity: f64,
+        tolerance: Tolerance,
+        constant_deceleration: f64,
+    ) -> Self {
+        let mut simulation = Self {
+            drag,
+            drag_log: drag.ln(),
+            x: position,
+            v: velocity,
+            // Dart's `double.sign` is 0.0 at zero, Rust's `signum` is not.
+            constant_deceleration: constant_deceleration
+                * if velocity == 0. {
+                    0.
+                } else {
+                    velocity.signum()
+                },
+            // needs to be infinity for newtonsMethod call in constructor.
+            final_time: f64::INFINITY,
+            tolerance,
+        };
+        simulation.final_time = newtons_method(
+            0.,
+            0.,
+            |time| simulation.dx(time),
+            |time| {
+                (simulation.v * simulation.drag.powf(time) * simulation.drag_log)
+                    - simulation.constant_deceleration
+            },
+            10,
+        );
+        simulation
+    }
+
+    /// The value of [`Simulation::x`] at `f64::INFINITY`.
+    pub fn final_x(&self) -> f64 {
+        if self.constant_deceleration == 0. {
+            return self.x - self.v / self.drag_log;
+        }
+        self.x(self.final_time)
+    }
+
+    /// The time at which the value of `x(time)` will equal `x`.
+    ///
+    /// Returns `f64::INFINITY` if the simulation will never reach `x`.
+    pub fn time_at_x(&self, x: f64) -> f64 {
+        if x == self.x {
+            return 0.0;
+        }
+        let final_x = self.final_x();
+        let out_of_reach = if self.v > 0. {
+            x < self.x || x > final_x
+        } else {
+            x > self.x || x < final_x
+        };
+        if self.v == 0.0 || out_of_reach {
+            return f64::INFINITY;
+        }
+        newtons_method(0., x, |time| self.x(time), |time| self.dx(time), 10)
+    }
+}
+
+impl Simulation for FrictionSimulation {
+    fn x(&self, time: f64) -> f64 {
+        if time > self.final_time {
+            return self.final_x();
+        }
+        self.x + self.v * self.drag.powf(time) / self.drag_log
+            - self.v / self.drag_log
+            - ((self.constant_deceleration / 2.) * time * time)
+    }
+
+    fn dx(&self, time: f64) -> f64 {
+        if time > self.final_time {
+            return 0.;
+        }
+        self.v * self.drag.powf(time) - self.constant_deceleration * time
+    }
+
+    fn is_done(&self, time: f64) -> bool {
+        self.dx(time).abs() < self.tolerance.velocity
+    }
+}
+
+/// An implementation of scroll physics that aligns with Android.
+///
+/// For any value of `velocity`, this travels the same total distance as the
+/// Android scroll physics.
+///
+/// This scroll physics has been adjusted relative to Android's in order to make
+/// it ballistic, meaning that the deceleration at any moment is a function only
+/// of the current velocity [`Simulation::dx`] and does not depend on how long ago the
+/// simulation was started. Compared to this scroll physics, Android's moves
+/// faster at the very beginning, then slower, and it ends at the same place but
+/// a little later.
+//
+// This class is based on OverScroller.java from Android:
+//   https://android.googlesource.com/platform/frameworks/base/+/android-13.0.0_r24/core/java/android/widget/OverScroller.java#738
+// and in particular class SplineOverScroller (at the end of the file), starting
+// at method "fling".  (A very similar algorithm is in Scroller.java in the same
+// directory, but OverScroller is what's used by RecyclerView.)
+//
+// In the Android implementation, times are in milliseconds, positions are in
+// physical pixels, but velocity is in physical pixels per whole second.
+//
+// The "See..." comments below refer to SplineOverScroller methods and values.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ClampingScrollSimulation {
+    /// The position of the particle at the beginning of the simulation, in
+    /// pixels.
+    position: f64,
+    /// The velocity at which the particle is traveling at the beginning of the
+    /// simulation, in pixels per second.
+    velocity: f64,
+    /// The total time the simulation will run, in seconds.
+    duration: f64,
+    /// The total, signed, distance the simulation will travel, in pixels.
+    distance: f64,
+}
+
+impl ClampingScrollSimulation {
+    // See INFLEXION.
+    const K_INFLEXION: f64 = 0.35;
+
+    /// Creates a scroll physics simulation that aligns with Android scrolling.
+    ///
+    /// `friction` is the amount of friction the particle experiences as it
+    /// travels: the more, the sooner it stops and the less far it travels.
+    /// `0.015` travels the same total distance as the Android scroll physics
+    /// (see mFlingFriction).
+    ///
+    /// `pixels_per_inch` stands in for Flutter's `160.0 // 1 inch / 1 logical pixel`
+    /// in `_physicalCoeff`, so a fling can run in a space of another density.
+    pub fn new(position: f64, velocity: f64, friction: f64, pixels_per_inch: f64) -> Self {
+        // See mPhysicalCoeff.  This has a value of 0.84 times Earth gravity,
+        // expressed in units of pixels per second^2.
+        let physical_coeff = 9.80665 // g, in meters per second^2
+            * 39.37 // 1 meter / 1 inch
+            * pixels_per_inch // 1 inch / 1 pixel
+            * 0.84; // "look and feel tuning"
+        // See DECELERATION_RATE.
+        let k_deceleration_rate = Self::k_deceleration_rate();
+
+        // See getSplineFlingDuration().
+        // See getSplineDeceleration().  That function's value is
+        // math.log(velocity.abs() / referenceVelocity).
+        let reference_velocity = friction * physical_coeff / Self::K_INFLEXION;
+        // This is the value getSplineFlingDuration() would return, but in seconds.
+        let android_duration =
+            (velocity.abs() / reference_velocity).powf(1. / (k_deceleration_rate - 1.0));
+        // We finish a bit sooner than Android, in order to travel the
+        // same total distance.
+        let duration = k_deceleration_rate * Self::K_INFLEXION * android_duration;
+
+        // See getSplineFlingDistance().  This returns the same value but with the
+        // sign of [velocity], and in pixels.
+        let distance = velocity * duration / k_deceleration_rate;
+
+        Self {
+            position,
+            velocity,
+            duration,
+            distance,
+        }
+    }
+
+    // See DECELERATION_RATE.
+    fn k_deceleration_rate() -> f64 {
+        0.78f64.ln() / 0.9f64.ln()
+    }
+}
+
+impl Simulation for ClampingScrollSimulation {
+    fn x(&self, time: f64) -> f64 {
+        let t = (time / self.duration).clamp(0.0, 1.0);
+        self.position + self.distance * (1.0 - (1.0 - t).powf(Self::k_deceleration_rate()))
+    }
+
+    fn dx(&self, time: f64) -> f64 {
+        let t = (time / self.duration).clamp(0.0, 1.0);
+        self.velocity * (1.0 - t).powf(Self::k_deceleration_rate() - 1.0)
+    }
+
+    fn is_done(&self, time: f64) -> bool {
+        time >= self.duration
+    }
+}
+
+/// Flutter's tests as the spec (AGENTS.md, Flutter rule 6): each row is named
+/// after the Flutter test it ports. Add a row per new Flutter case.
+#[cfg(test)]
+mod tests {
+    use super::super::ScrollPhysics;
+    use super::*;
+
+    /// flutter_test's `precisionErrorTolerance`, `moreOrLessEquals`' default epsilon.
+    const PRECISION: f64 = 1e-10;
+    const INF: f64 = f64::INFINITY;
+
+    /// One `expect` on a [`FrictionSimulation`].
+    enum Expect {
+        /// `x(time)` within epsilon of a value.
+        X(f64, f64, f64),
+        /// `dx(time)` within epsilon of a value.
+        Dx(f64, f64, f64),
+        /// `x(time)` strictly between two values.
+        XBetween(f64, f64, f64),
+        /// `dx(time)` strictly below a value.
+        DxBelow(f64, f64),
+        /// `finalX` within epsilon of a value.
+        FinalX(f64, f64),
+        /// `timeAtX(x)` equals a value exactly.
+        TimeAtX(f64, f64),
+        /// `timeAtX(x(time))` within [`PRECISION`] of `time`.
+        TimeAtOwnX(f64),
+        IsDone(f64, bool),
+    }
+    use Expect::*;
+
+    struct FrictionCase {
+        flutter_test: &'static str,
+        drag: f64,
+        position: f64,
+        velocity: f64,
+        tolerance_velocity: f64,
+        constant_deceleration: f64,
+        expects: &'static [Expect],
+    }
+
+    const DEFAULT_VELOCITY: f64 = Tolerance::DEFAULT_TOLERANCE.velocity;
+
+    const FRICTION_CASES: &[FrictionCase] = &[
+        FrictionCase {
+            flutter_test: "friction_simulation_test.dart: Friction simulation positive velocity",
+            drag: 0.135,
+            position: 100.0,
+            velocity: 100.0,
+            tolerance_velocity: DEFAULT_VELOCITY,
+            constant_deceleration: 0.,
+            expects: &[
+                X(0.0, 100.0, PRECISION),
+                Dx(0.0, 100.0, PRECISION),
+                X(0.1, 110.0, 1.0),
+                X(0.5, 131.0, 1.0),
+                X(2.0, 149.0, 1.0),
+                FinalX(149.0, 1.0),
+                TimeAtX(100.0, 0.0),
+                TimeAtOwnX(0.1),
+                TimeAtOwnX(0.5),
+                TimeAtOwnX(2.0),
+                TimeAtX(-1.0, INF),
+                TimeAtX(200.0, INF),
+            ],
+        },
+        FrictionCase {
+            flutter_test: "friction_simulation_test.dart: Friction simulation negative velocity",
+            drag: 0.135,
+            position: 100.0,
+            velocity: -100.0,
+            tolerance_velocity: DEFAULT_VELOCITY,
+            constant_deceleration: 0.,
+            expects: &[
+                X(0.0, 100.0, PRECISION),
+                Dx(0.0, -100.0, PRECISION),
+                X(0.1, 91.0, 1.0),
+                X(0.5, 68.0, 1.0),
+                X(2.0, 51.0, 1.0),
+                FinalX(50.0, 1.0),
+                TimeAtX(100.0, 0.0),
+                TimeAtOwnX(0.1),
+                TimeAtOwnX(0.5),
+                TimeAtOwnX(2.0),
+                TimeAtX(101.0, INF),
+                TimeAtX(40.0, INF),
+            ],
+        },
+        FrictionCase {
+            flutter_test: "friction_simulation_test.dart: Friction simulation constant deceleration",
+            drag: 0.135,
+            position: 100.0,
+            velocity: -100.0,
+            tolerance_velocity: DEFAULT_VELOCITY,
+            constant_deceleration: 100.,
+            expects: &[
+                X(0.0, 100.0, PRECISION),
+                Dx(0.0, -100.0, PRECISION),
+                X(0.1, 91.0, 1.0),
+                X(0.5, 80.0, 1.0),
+                X(2.0, 80.0, 1.0),
+                FinalX(80.0, 1.0),
+                TimeAtX(100.0, 0.0),
+                TimeAtOwnX(0.1),
+                TimeAtOwnX(0.2),
+                TimeAtOwnX(0.3),
+                TimeAtX(101.0, INF),
+                TimeAtX(40.0, INF),
+            ],
+        },
+        FrictionCase {
+            flutter_test: "newton_test.dart: test_friction",
+            drag: 0.3,
+            position: 100.0,
+            velocity: 400.0,
+            tolerance_velocity: 1.0,
+            constant_deceleration: 0.,
+            expects: &[
+                IsDone(0.0, false),
+                X(0.0, 100.0, 0.0),
+                Dx(0.0, 400.0, 0.0),
+                XBetween(1.0, 330.0, 335.0),
+                Dx(1.0, 120.0, 0.0),
+                Dx(2.0, 36.0, 0.0),
+                Dx(3.0, 10.8, PRECISION),
+                DxBelow(4.0, 3.5),
+                IsDone(5.0, true),
+                XBetween(5.0, 431.0, 432.0),
+            ],
+        },
+        // BouncingScrollSimulation inside its extents is a FrictionSimulation
+        // with drag 0.135; only that part is ported here.
+        FrictionCase {
+            flutter_test: "newton_test.dart: scroll_with_inf_edge_ends",
+            drag: 0.135,
+            position: 100.0,
+            velocity: 400.0,
+            tolerance_velocity: 1.0,
+            constant_deceleration: 0.,
+            expects: &[
+                IsDone(0.0, false),
+                X(0.0, 100.0, 0.0),
+                Dx(0.0, 400.0, 0.0),
+                X(1.0, 272.0, 1.0),
+                Dx(1.0, 54.0, 1.0),
+                Dx(2.0, 7.0, 1.0),
+                DxBelow(3.0, 1.0),
+                IsDone(5.0, true),
+                X(5.0, 300.0, 1.0),
+            ],
