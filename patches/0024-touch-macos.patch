@@ -0,0 +1,302 @@
+//! Direct touches (a touchscreen Mac, or an iPad by Sidecar) as GPUI `TouchEvent`s, from macOS 27.
+//!
+//! AppKit hands direct touches to gesture recognizers only, never to a view's responder methods, so every
+//! GPUIView carries one `GPUITouchRecognizer`: an `NSGestureRecognizer` subclass overriding
+//! `touches…WithEvent:`, Apple's custom-recognizer pattern (`NSGestureRecognizer (NSSubclassUse)` in the SDK
+//! headers). It reads each changed `NSTouch` and hands it to GPUI, whose own recognizers (taps, pans, pinch)
+//! take it from there. Before macOS 27 no recognizer is added.
+
+use super::{is_macos_version_at_least, window_state_if_set};
+use gpui::{PlatformInput, PointerDevice, TouchEvent, TouchId, TouchPhase, point, px};
+use gpui_apple::process_info::uptime_instant;
+use objc2::{
+    class, msg_send,
+    rc::Retained,
+    runtime::{AnyClass, AnyObject, Bool, ClassBuilder, Sel},
+    sel,
+};
+use objc2_foundation::{NSInteger, NSOperatingSystemVersion, NSPoint, NSUInteger};
+use std::ptr;
+
+// `NSTouchPhase` bits (NSTouch.h).
+const BEGAN: NSUInteger = 1 << 0;
+const MOVED: NSUInteger = 1 << 1;
+const STATIONARY: NSUInteger = 1 << 2;
+const ENDED: NSUInteger = 1 << 3;
+const CANCELLED: NSUInteger = 1 << 4;
+const TOUCHING: NSUInteger = BEGAN | MOVED | STATIONARY;
+/// The touches an event changed: stationary ones have nothing new for GPUI.
+const CHANGED: NSUInteger = BEGAN | MOVED | ENDED | CANCELLED;
+
+/// AppKit touch phase → GPUI's. Extend: one row per `NSTouchPhase` bit in `CHANGED`.
+const PHASES: [(NSUInteger, TouchPhase); 4] = [
+    (BEGAN, TouchPhase::Started),
+    (MOVED, TouchPhase::Moved),
+    (ENDED, TouchPhase::Ended),
+    (CANCELLED, TouchPhase::Cancelled),
+];
+
+/// `NSTouchTypeMaskDirect` (NSTouch.h): a finger on a screen.
+const TOUCH_TYPE_MASK_DIRECT: NSUInteger = 1 << 0;
+
+/// The first macOS with direct touch (`NSScreen.touchCapabilities`, `NSIsTouchNative` are `macos(27.0)`).
+const DIRECT_TOUCH_MACOS: NSOperatingSystemVersion = NSOperatingSystemVersion {
+    majorVersion: 27,
+    minorVersion: 0,
+    patchVersion: 0,
+};
+
+/// `NSGestureRecognizerState` (NSGestureRecognizer.h), as the recognizer reports it to AppKit.
+#[repr(isize)] // NSInteger
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum RecognizerState {
+    Possible = 0,
+    Began = 1,
+    Changed = 2,
+    Ended = 3,
+    Cancelled = 4,
+}
+
+/// The recognizer's state once an event is handled: it claims the touch sequence from its first touch (GPUI
+/// recognizes the gestures itself) and finishes when no finger is down.
+fn next_state(current: NSInteger, touching: bool, cancelled: bool) -> RecognizerState {
+    match (touching, cancelled) {
+        (true, _) if current == RecognizerState::Possible as NSInteger => RecognizerState::Began,
+        (true, _) => RecognizerState::Changed,
+        (false, true) => RecognizerState::Cancelled,
+        (false, false) => RecognizerState::Ended,
+    }
+}
+
+fn touch_phase(bits: NSUInteger) -> Option<TouchPhase> {
+    PHASES
+        .iter()
+        .find(|(bit, _)| *bit == bits)
+        .map(|(_, phase)| *phase)
+}
+
+/// GPUI's ids for the touches down now. `NSTouch` objects do not persist and their `identity` may be reused by a
+/// later touch, so a new identity takes the next id and gives it up when its touch ends. Generic so the id
+/// rules are tested without AppKit.
+pub(super) struct TouchIds<K> {
+    last: u64,
+    live: Vec<(K, TouchId)>,
+}
+
+impl<K> Default for TouchIds<K> {
+    fn default() -> Self {
+        Self {
+            last: 0,
+            live: Vec::new(),
+        }
+    }
+}
+
+impl<K: PartialEq> TouchIds<K> {
+    fn track(&mut self, key: K, phase: TouchPhase) -> TouchId {
+        let id = match self.live.iter().find(|(live, _)| *live == key) {
+            Some((_, id)) => *id,
+            None => {
+                self.last += 1;
+                let id = TouchId(self.last);
+                self.live.push((key, id));
+                id
+            }
+        };
+        match phase {
+            TouchPhase::Started | TouchPhase::Moved => {}
+            TouchPhase::Ended | TouchPhase::Cancelled => self.live.retain(|(_, live)| *live != id),
+        }
+        id
+    }
+}
+
+/// An `NSTouch.identity`, compared with `isEqual:` as NSTouch.h asks.
+pub(super) struct TouchIdentity(Retained<AnyObject>);
+
+impl PartialEq for TouchIdentity {
+    fn eq(&self, other: &Self) -> bool {
+        // SAFETY: both are live identity objects, which implement `NSObject`'s `isEqual:`.
+        let equal: Bool = unsafe { msg_send![&*self.0, isEqual: &*other.0] };
+        equal.as_bool()
+    }
+}
+
+/// Registers `GPUITouchRecognizer`; `build_classes` calls it once at load.
+pub(super) unsafe fn register_touch_recognizer_class() {
+    let mut decl = ClassBuilder::new(c"GPUITouchRecognizer", class!(NSGestureRecognizer))
+        .expect("GPUITouchRecognizer is registered once, by build_classes");
+    // One handler for the four callbacks: each touch carries its own phase.
+    for selector in [
+        sel!(touchesBeganWithEvent:),
+        sel!(touchesMovedWithEvent:),
+        sel!(touchesEndedWithEvent:),
+        sel!(touchesCancelledWithEvent:),
+    ] {
+        // SAFETY: the signature matches `- (void)touches…WithEvent:(NSEvent *)event`.
+        unsafe { decl.add_method(selector, handle_touches as extern "C" fn(_, _, _)) };
+    }
+    decl.register();
+}
+
+/// Gives `view` (a GPUIView) its direct-touch recognizer, on macOS 27 and later.
+pub(super) unsafe fn add_touch_recognizer(view: *mut AnyObject) {
+    if !is_macos_version_at_least(DIRECT_TOUCH_MACOS) {
+        return;
+    }
+    let class: &AnyClass = class!(GPUITouchRecognizer);
+    // SAFETY: on the main thread during window creation; `initWithTarget:action:` takes a nil target and action
+    // (the handler is the subclass's own `touches…WithEvent:`). The view retains the recognizer, so ours is
+    // autoreleased.
+    unsafe {
+        let recognizer: *mut AnyObject = msg_send![class, alloc];
+        let recognizer: *mut AnyObject = msg_send![
+            recognizer,
+            initWithTarget: ptr::null_mut::<AnyObject>(),
+            action: None::<Sel>
+        ];
+        let _: () = msg_send![recognizer, setAllowedTouchTypes: TOUCH_TYPE_MASK_DIRECT];
+        let _: () = msg_send![view, addGestureRecognizer: recognizer];
+        let _: *mut AnyObject = msg_send![recognizer, autorelease];
+    }
+}
+
+extern "C" fn handle_touches(this: &AnyObject, _: Sel, native_event: *mut AnyObject) {
+    // SAFETY: AppKit calls this on the main thread with a live `NSEvent`, for a recognizer that
+    // `add_touch_recognizer` put on a GPUIView, which owns the window-state ivar.
+    unsafe {
+        let view: *mut AnyObject = msg_send![this, view];
+        let Some(view) = view.as_ref() else { return };
+        let Some(window_state) = window_state_if_set(view) else {
+            return;
+        };
+        // Ported from flutter/flutter engine/src/flutter/shell/platform/darwin/macos/
+        // framework/Source/FlutterViewController.mm (its pointer events'
+        // `.timestamp = static_cast<size_t>(event.timestamp * USEC_PER_SEC)`) @ 3.50.1
+        // (ae9b586f34a8443573f82ef57c3bf914a908cbf7). Copyright 2014 The Flutter
+        // Authors. BSD-3-Clause, see third_party/flutter/LICENSE.
+        // `NSEvent.timestamp` counts seconds since boot, as `UITouch.timestamp` does.
+        let time_stamp = uptime_instant(msg_send![native_event, timestamp]);
+        let none: *const AnyObject = ptr::null();
+        let changed: *mut AnyObject =
+            msg_send![native_event, touchesMatchingPhase: CHANGED, inView: none];
+        let changed: *mut AnyObject = msg_send![changed, allObjects];
+        let count: NSUInteger = msg_send![changed, count];
+        let mut cancelled = false;
+        for index in 0..count {
+            let touch: *mut AnyObject = msg_send![changed, objectAtIndex: index];
+            let Some(phase) = touch_phase(msg_send![touch, phase]) else {
+                continue;
+            };
+            cancelled |= phase == TouchPhase::Cancelled;
+            let identity: *mut AnyObject = msg_send![touch, identity];
+            let Some(identity) = Retained::retain(identity) else {
+                continue;
+            };
+            let location: NSPoint = msg_send![touch, locationInView: view];
+            let mut lock = window_state.lock();
+            let event = TouchEvent {
+                id: lock.touch_ids.track(TouchIdentity(identity), phase),
+                phase,
+                // GPUIView is not flipped: AppKit's y grows upward, as for mouse events.
+                position: point(
+                    px(location.x as f32),
+                    lock.content_size().height - px(location.y as f32),
+                ),
+                predicted_position: None,
+                force: None,
+                device: PointerDevice::Touch,
+                time_stamp,
+            };
+            let Some(mut callback) = lock.event_callback.take() else {
+                continue;
+            };
+            drop(lock);
+            callback(PlatformInput::Touch(event));
+            window_state.lock().event_callback = Some(callback);
+        }
+        let touching: *mut AnyObject =
+            msg_send![native_event, touchesMatchingPhase: TOUCHING, inView: none];
+        let touching: NSUInteger = msg_send![touching, count];
+        let state: NSInteger = msg_send![this, state];
+        let next = next_state(state, touching > 0, cancelled) as NSInteger;
+        let _: () = msg_send![this, setState: next];
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn touch_phases() {
+        let cases = [
+            ("began", BEGAN, Some(TouchPhase::Started)),
+            ("moved", MOVED, Some(TouchPhase::Moved)),
+            ("ended", ENDED, Some(TouchPhase::Ended)),
+            ("cancelled", CANCELLED, Some(TouchPhase::Cancelled)),
+            ("stationary is not a change", STATIONARY, None),
+        ];
+        for (name, bits, expected) in cases {
+            assert_eq!(touch_phase(bits), expected, "{name}");
+        }
+    }
+
+    #[test]
+    fn recognizer_states() {
+        use RecognizerState::*;
+        let cases = [
+            (
+                "first touch claims the sequence",
+                Possible,
+                true,
+                false,
+                Began,
+            ),
+            ("more touches", Began, true, false, Changed),
+            (
+                "a finger lifts, another stays",
+                Changed,
+                true,
+                false,
+                Changed,
+            ),
+            (
+                "one finger cancelled, another stays",
+                Changed,
+                true,
+                true,
+                Changed,
+            ),
+            ("last finger lifts", Changed, false, false, Ended),
+            ("tap in one event", Possible, false, false, Ended),
+            ("system takes the touches", Changed, false, true, Cancelled),
+        ];
+        for (name, current, touching, cancelled, expected) in cases {
+            assert_eq!(
+                next_state(current as NSInteger, touching, cancelled),
+                expected,
+                "{name}"
+            );
+        }
+    }
+
+    #[test]
+    fn touch_ids() {
+        use TouchPhase::*;
+        // (identity, phase, expected id): identities are reused, ids never are.
+        let cases = [
+            ("first finger down", 7, Started, 1),
+            ("second finger down", 8, Started, 2),
+            ("first finger moves", 7, Moved, 1),
+            ("first finger lifts", 7, Ended, 1),
+            ("identity reused by a new touch", 7, Started, 3),
+            ("second finger cancelled", 8, Cancelled, 2),
+            ("move with no begin still gets an id", 9, Moved, 4),
+        ];
+        let mut ids = TouchIds::default();
+        for (name, identity, phase, expected) in cases {
+            assert_eq!(ids.track(identity, phase), TouchId(expected), "{name}");
+        }
+    }
+}
