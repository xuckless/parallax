+
+impl Buffers {
+    /// GPUI places the view: the crop for the attached buffer, and a commit (cached until the
+    /// window's, as the subsurface is synchronized).
+    fn place(&mut self, crop: Crop) {
+        self.crop = Some(crop);
+        self.update_source();
+        self.surface.commit();
+    }
