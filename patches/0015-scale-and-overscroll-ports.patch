+#[test]
+fn rejects_scale_gestures_from_unallowed_device_kinds() {
+    replay(
+        "Rejects scale gestures from unallowed device kinds",
+        Arena::Solo,
+        touch_only,
+        &[
+            // One-finger panning
+            (Down(1, PointerDevice::Mouse, 0.0, 0.0, 0), &[]),
+            // Using a mouse, the scale gesture shouldn't even start.
+            (Move(1, 20.0, 30.0, 0), &[]),
+        ],
+    );
+}
