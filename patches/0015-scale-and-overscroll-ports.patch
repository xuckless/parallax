index 0000000..bd37972
--- /dev/null
+++ b/gpui-pre/src/overscroll/spring_simulation.rs
@@ -0,0 +1,220 @@
+// Ported from flutter/flutter packages/flutter/lib/src/physics/spring_simulation.dart @ 3.50.1
+// (ae9b586f34a8443573f82ef57c3bf914a908cbf7). Copyright 2014 The Flutter Authors. BSD-3-Clause, see
+// third_party/flutter/LICENSE.
+//
+// Dropped: `SpringDescription.withDurationAndBounce`, `duration` and `bounce`, and `SpringSimulation`'s `snapToEnd`
+// (nothing here uses them). GPUI's own `SpringConfig` (spring.rs) steps an f32 state instead; these keep Flutter's
+// f64 closed forms and its `isDone`, which the ported tests' values depend on.
+
+use super::near_zero;
+use crate::{Simulation, Tolerance};
+
+/// Structure that describes a spring's constants.
+///
+/// Used to configure a [`SpringSimulation`].
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct SpringDescription {
+    /// The mass of the spring (m).
+    ///
+    /// The greater the mass, the larger the amplitude of oscillation,
+    /// and the longer the time to return to the equilibrium position.
+    pub mass: f64,
+    /// The spring constant (k).
+    ///
+    /// Stiffness defines the spring constant, which measures the strength of
+    /// the spring. A stiff spring applies more force to the object that is
+    /// attached for some deviation from the rest position.
+    pub stiffness: f64,
+    /// The damping coefficient (c).
+    ///
+    /// Do not confuse the damping _coefficient_ (c) with the damping _ratio_ (ζ).
+    /// To create a [`SpringDescription`] with a damping ratio, use
+    /// [`SpringDescription::with_damping_ratio`].
+    pub damping: f64,
+}
+
+impl SpringDescription {
+    /// Creates a spring given the mass (m), stiffness (k), and damping ratio (ζ).
+    /// The damping ratio describes a gradual reduction in a spring oscillation.
+    ///
+    /// A ratio of 1.0 creates a critically damped spring, > 1.0 creates an
+    /// overdamped spring and < 1.0 an underdamped one.
+    pub fn with_damping_ratio(mass: f64, stiffness: f64, ratio: f64) -> Self {
+        Self {
+            mass,
+            stiffness,
+            damping: ratio * 2.0 * (mass * stiffness).sqrt(),
+        }
+    }
+}
+
+/// The kind of spring solution that the [`SpringSimulation`] is using to simulate the spring.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SpringType {
+    /// A spring that does not bounce and returns to its rest position in the
+    /// shortest possible time.
+    CriticallyDamped,
+    /// A spring that bounces.
+    UnderDamped,
+    /// A spring that does not bounce but takes longer to return to its rest
+    /// position than a [`SpringType::CriticallyDamped`] one.
+    OverDamped,
+}
+
+/// A spring simulation.
+///
+/// Models a particle attached to a spring that follows Hooke's law.
+#[derive(Clone, Copy, Debug)]
+pub struct SpringSimulation {
+    end_position: f64,
+    solution: SpringSolution,
+    /// How close to the end of the simulation a value must be before [`Simulation::is_done`] holds.
+    pub tolerance: Tolerance,
+}
+
+impl SpringSimulation {
+    /// Creates a spring simulation from the provided spring description, start
+    /// distance, end distance, and initial velocity.
+    ///
+    /// The units for distance and velocity are arbitrary, but must be consistent
+    /// with the units used for other lengths in the system.
+    pub fn new(
+        spring: SpringDescription,
+        start: f64,
+        end: f64,
+        velocity: f64,
+        tolerance: Tolerance,
+    ) -> Self {
+        Self {
+            end_position: end,
+            solution: SpringSolution::new(spring, start - end, velocity),
+            tolerance,
+        }
+    }
+
+    /// The kind of spring being simulated, for debugging purposes.
+    pub fn spring_type(&self) -> SpringType {
+        match self.solution {
+            SpringSolution::Critical { .. } => SpringType::CriticallyDamped,
+            SpringSolution::Overdamped { .. } => SpringType::OverDamped,
+            SpringSolution::Underdamped { .. } => SpringType::UnderDamped,
+        }
+    }
+}
+
+impl Simulation for SpringSimulation {
+    fn x(&self, time: f64) -> f64 {
+        self.end_position + self.solution.x(time)
+    }
+
+    fn dx(&self, time: f64) -> f64 {
+        self.solution.dx(time)
+    }
+
+    fn is_done(&self, time: f64) -> bool {
+        near_zero(self.solution.x(time), self.tolerance.distance)
+            && near_zero(self.solution.dx(time), self.tolerance.velocity)
+    }
+}
+
+/// A [`SpringSimulation`] where the value of [`Simulation::x`] is guaranteed to
+/// have exactly the end value when the simulation [`Simulation::is_done`].
+#[derive(Clone, Copy, Debug)]
+pub struct ScrollSpringSimulation(pub SpringSimulation);
+
+impl ScrollSpringSimulation {
+    /// Creates a spring simulation from the provided spring description, start
+    /// distance, end distance, and initial velocity.
+    pub fn new(
+        spring: SpringDescription,
+        start: f64,
+        end: f64,
+        velocity: f64,
+        tolerance: Tolerance,
+    ) -> Self {
+        Self(SpringSimulation::new(
+            spring, start, end, velocity, tolerance,
+        ))
+    }
+}
+
+impl Simulation for ScrollSpringSimulation {
+    fn x(&self, time: f64) -> f64 {
+        if self.is_done(time) {
+            self.0.end_position
+        } else {
+            self.0.x(time)
+        }
+    }
+
+    fn dx(&self, time: f64) -> f64 {
+        self.0.dx(time)
+    }
+
+    fn is_done(&self, time: f64) -> bool {
+        self.0.is_done(time)
+    }
+}
+
+// SPRING IMPLEMENTATIONS
+
+/// Flutter's `_SpringSolution` subclasses, one variant each, chosen by the sign of `c² - 4mk`.
+#[derive(Clone, Copy, Debug)]
+enum SpringSolution {
+    Critical { r: f64, c1: f64, c2: f64 },
+    Overdamped { r1: f64, r2: f64, c1: f64, c2: f64 },
+    Underdamped { w: f64, r: f64, c1: f64, c2: f64 },
+}
+
+impl SpringSolution {
+    fn new(spring: SpringDescription, distance: f64, velocity: f64) -> Self {
+        let cmk = spring.damping * spring.damping - 4.0 * spring.mass * spring.stiffness;
+        if cmk > 0.0 {
+            let r1 = (-spring.damping - cmk.sqrt()) / (2.0 * spring.mass);
+            let r2 = (-spring.damping + cmk.sqrt()) / (2.0 * spring.mass);
+            let c2 = (velocity - r1 * distance) / (r2 - r1);
+            let c1 = distance - c2;
+            Self::Overdamped { r1, r2, c1, c2 }
+        } else if cmk < 0.0 {
+            let w = (4.0 * spring.mass * spring.stiffness - spring.damping * spring.damping).sqrt()
+                / (2.0 * spring.mass);
+            let r = -(spring.damping / 2.0 / spring.mass);
+            let c1 = distance;
+            let c2 = (velocity - r * distance) / w;
+            Self::Underdamped { w, r, c1, c2 }
+        } else {
+            let r = -spring.damping / (2.0 * spring.mass);
+            let c1 = distance;
+            let c2 = velocity - (r * distance);
+            Self::Critical { r, c1, c2 }
+        }
+    }
+
+    fn x(&self, time: f64) -> f64 {
+        match *self {
+            Self::Critical { r, c1, c2 } => (c1 + c2 * time) * (r * time).exp(),
+            Self::Overdamped { r1, r2, c1, c2 } => c1 * (r1 * time).exp() + c2 * (r2 * time).exp(),
+            Self::Underdamped { w, r, c1, c2 } => {
+                (r * time).exp() * (c1 * (w * time).cos() + c2 * (w * time).sin())
+            }
+        }
+    }
+
+    fn dx(&self, time: f64) -> f64 {
+        match *self {
+            Self::Critical { r, c1, c2 } => {
+                let power = (r * time).exp();
+                r * (c1 + c2 * time) * power + c2 * power
+            }
+            Self::Overdamped { r1, r2, c1, c2 } => {
+                c1 * r1 * (r1 * time).exp() + c2 * r2 * (r2 * time).exp()
+            }
+            Self::Underdamped { w, r, c1, c2 } => {
+                let power = (r * time).exp();
+                let cosine = (w * time).cos();
+                let sine = (w * time).sin();
+                power * (c2 * w * cosine - c1 * w * sine) + r * power * (c2 * sine + c1 * cosine)
+            }
+        }
+    }
+}
