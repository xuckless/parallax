diff --git a/gpui-pre-apple/src/native_view_placement.rs b/gpui-pre-apple/src/native_view_placement.rs
new file mode 100644
index 0000000..f49d5b2
--- /dev/null
+++ b/gpui-pre-apple/src/native_view_placement.rs
@@ -0,0 +1,231 @@
+//! Where a native view's clipping container and view go in the window, and how far inside the view its hole is
+//! cut: shared by gpui_macos (AppKit, y up) and gpui_ios (UIKit, y down). Pure, so scripts/patch-test.sh runs its
+//! tests on the host (`apple-pure`).
+//!
+//! Edges follow Chromium's rule for overlays under a window (ui/ozone wayland_subsurface.cc, as patch 0049's
+//! Wayland subsurfaces): the view is rounded outwards to whole device pixels, and where the compositor resamples
+//! the window's pixels (a scale that is not a whole number of physical pixels per device pixel) the hole is cut one
+//! pixel inside the view, so the window's own pixels cover the view's blended edges and no gap shows between them.
+
+use gpui::{Bounds, ScaledPixels, size};
+
+/// Which way the platform's view coordinates grow vertically.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum YAxis {
+    /// UIKit: from the top left.
+    Down,
+    /// AppKit: from the bottom left.
+    Up,
+}
+
+/// Where a native view is shown, as `[x, y, width, height]` frames in points.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Placement {
+    /// The visible part of the view, in the superview of GPUI's view.
+    pub container: [f64; 4],
+    /// The whole view, in its container.
+    pub view: [f64; 4],
+}
+
+impl Placement {
+    /// Places a view with the given bounds and clip, both in device pixels from the top left of GPUI's view, whose
+    /// frame in its superview is `gpui_frame`. Returns `None` if the clip leaves none of the view visible.
+    pub fn new(
+        bounds: Bounds<ScaledPixels>,
+        content_mask: Bounds<ScaledPixels>,
+        scale_factor: f64,
+        gpui_frame: [f64; 4],
+        y_axis: YAxis,
+    ) -> Option<Self> {
+        let visible = bounds.intersect(&content_mask);
+        if visible.is_empty() {
+            return None;
+        }
+        let to_frame = |bounds: Bounds<ScaledPixels>| {
+            let bounds = round_outwards(bounds);
+            let [gpui_x, gpui_y, _, gpui_height] = gpui_frame;
+            let to_points = |value: ScaledPixels| f64::from(value) / scale_factor;
+            let top = to_points(bounds.origin.y);
+            let height = to_points(bounds.size.height);
+            let y = match y_axis {
+                YAxis::Down => gpui_y + top,
+                YAxis::Up => gpui_y + gpui_height - top - height,
+            };
+            [
+                gpui_x + to_points(bounds.origin.x),
+                y,
+                to_points(bounds.size.width),
+                height,
+            ]
+        };
+        let container = to_frame(visible);
+        let [x, y, width, height] = to_frame(bounds);
+        Some(Self {
+            container,
+            view: [x - container[0], y - container[1], width, height],
+        })
+    }
+}
+
+/// The smallest whole-pixel bounds that hold `bounds`.
+fn round_outwards(bounds: Bounds<ScaledPixels>) -> Bounds<ScaledPixels> {
+    let origin = bounds.origin.map(|value| value.floor());
+    let end = bounds.bottom_right().map(|value| value.ceil());
+    Bounds {
+        origin,
+        size: size(end.x - origin.x, end.y - origin.y),
+    }
+}
+
+/// How far inside a view's bounds its hole is cut, given the device pixels per point GPUI draws at and the physical
+/// pixels per point the screen shows: one device pixel where they differ (the compositor resamples, so the view's
+/// and the hole's edges both blend), none where they match.
+pub fn hole_inset(scale_factor: f64, physical_scale: f64) -> ScaledPixels {
+    if scale_factor == physical_scale {
+        ScaledPixels(0.)
+    } else {
+        ScaledPixels(1.)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use gpui::point;
+
+    /// Bounds in device pixels.
+    fn scaled(x: f32, y: f32, width: f32, height: f32) -> Bounds<ScaledPixels> {
+        Bounds {
+            origin: point(ScaledPixels(x), ScaledPixels(y)),
+            size: size(ScaledPixels(width), ScaledPixels(height)),
+        }
+    }
+
+    #[test]
+    fn placement_clips_a_view_to_its_content_mask() {
+        // macOS's rows: a 400 by 300 point GPUI view at twice the scale, 10 points above the bottom of the content
+        // view.
+        let mac_frame = [0., 10., 400., 300.];
+        // (name, bounds, content mask, scale, GPUI frame, y axis, placement)
+        let cases = [
+            (
+                "macOS: unclipped",
+                scaled(100., 40., 200., 400.),
+                scaled(0., 0., 800., 600.),
+                2.,
+                mac_frame,
+                YAxis::Up,
+                Some(Placement {
+                    container: [50., 90., 100., 200.],
+                    view: [0., 0., 100., 200.],
+                }),
+            ),
+            (
+                // The container shrinks, and the view keeps its size and stays where it was in the window.
+                "macOS: clipped on the top and left",
+                scaled(100., 40., 200., 400.),
+                scaled(120., 100., 800., 600.),
+                2.,
+                mac_frame,
+                YAxis::Up,
+                Some(Placement {
+                    container: [60., 90., 90., 170.],
+                    view: [-10., 0., 100., 200.],
+                }),
+            ),
+            (
+                "macOS: clipped away",
+                scaled(100., 40., 200., 400.),
+                scaled(0., 500., 800., 100.),
+                2.,
+                mac_frame,
+                YAxis::Up,
+                None,
+            ),
+            (
+                "iOS: unclipped at 2x",
+                scaled(20., 40., 200., 100.),
+                scaled(0., 0., 1000., 1000.),
+                2.,
+                [0., 0., 500., 500.],
+                YAxis::Down,
+                Some(Placement {
+                    container: [10., 20., 100., 50.],
+                    view: [0., 0., 100., 50.],
+                }),
+            ),
+            (
+                "iOS: clipped on the top left at 3x",
+                scaled(0., 0., 300., 300.),
+                scaled(30., 60., 600., 600.),
+                3.,
+                [0., 0., 500., 500.],
+                YAxis::Down,
+                Some(Placement {
+                    container: [10., 20., 90., 80.],
+                    view: [-10., -20., 100., 100.],
+                }),
+            ),
+            (
+                "iOS: GPUI's view offset in the window",
+                scaled(0., 0., 100., 100.),
+                scaled(0., 0., 100., 100.),
+                1.,
+                [5., 7., 100., 100.],
+                YAxis::Down,
+                Some(Placement {
+                    container: [5., 7., 100., 100.],
+                    view: [0., 0., 100., 100.],
+                }),
+            ),
+            (
+                // Chromium's rule: a view never ends partway through a pixel, so it covers its hole's every pixel.
+                "fractional bounds round outwards to whole device pixels",
+                scaled(10.5, 20.25, 100., 50.5),
+                scaled(0., 0., 1000., 1000.),
+                2.,
+                [0., 0., 500., 500.],
+                YAxis::Down,
+                Some(Placement {
+                    container: [5., 10., 50.5, 25.5],
+                    view: [0., 0., 50.5, 25.5],
+                }),
+            ),
+            (
+                "iOS: clipped away",
+                scaled(0., 0., 100., 100.),
+                scaled(200., 200., 10., 10.),
+                1.,
+                [0., 0., 500., 500.],
+                YAxis::Down,
+                None,
+            ),
+        ];
+        for (name, bounds, mask, scale, frame, y_axis, placement) in cases {
+            assert_eq!(
+                Placement::new(bounds, mask, scale, frame, y_axis),
+                placement,
+                "{name}"
+            );
+        }
+    }
+
+    #[test]
+    fn hole_is_cut_inside_the_view_only_where_the_compositor_resamples() {
+        // (name, GPUI's scale, the screen's physical scale, inset)
+        let cases = [
+            ("iPhone at 3x", 3., 3., 0.),
+            ("iPad and Retina Mac at 2x", 2., 2., 0.),
+            (
+                "iPhone with Display Zoom (3x drawn, 2.88x shown)",
+                3.,
+                2.88,
+                1.,
+            ),
+            ("iPad mini (2x drawn, 2.18x shown)", 2., 2.1875, 1.),
+        ];
+        for (name, scale, physical, inset) in cases {
+            assert_eq!(hole_inset(scale, physical), ScaledPixels(inset), "{name}");
+        }
+    }
+}
