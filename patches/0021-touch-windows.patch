+                10_000_000,
+                1_000,
+                Some(now),
+            ),
+            (
+                "no performance count: dwTime, 20 ms old",
+                0,
+                4_980,
+                Some(now - ms(20)),
+            ),
+            ("dwTime after the clock read is now", 0, 5_010, Some(now)),
+            (
+                "performance count after the clock read is now",
+                10_000_001,
+                0,
+                Some(now),
