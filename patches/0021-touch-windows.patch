+            ("neither: timed at dispatch", 0, 0, None),
+        ];
+        for (name, performance_count, time, expected) in rows {
+            assert_eq!(clock.at(performance_count, time), expected, "{name}");
+        }
+        let wrapped = Clock {
+            tick_count: 10,
+            ..clock
+        };
+        assert_eq!(
+            wrapped.at(0, u32::MAX - 9),
+            Some(now - ms(20)),
