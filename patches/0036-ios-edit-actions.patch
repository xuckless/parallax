+        fn can_perform_action(&self, action: Sel, sender: Option<&AnyObject>) -> bool {
+            if action == sel!(paste:) {
+                // Forbid pasting images, memojis, or other non-string content.
+                // SAFETY: the pasteboard is read on the main thread.
+                unsafe { pasteboard().hasStrings() }
