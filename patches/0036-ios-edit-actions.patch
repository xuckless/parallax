+                !secret && self.selected_text().is_some_and(|text| text.length() > 0)
+            } else if action == sel!(selectAll:) {
+                self.hasText()
+            } else if action == sel!(captureTextFromCamera:) {
+                true
+            } else {
+                unsafe { msg_send![super(self), canPerformAction: action, withSender: sender] }
+            }
+        }
