diff --git a/gpui-pre/src/gestures/pinch.rs b/gpui-pre/src/gestures/pinch.rs
new file mode 100644
index 0000000..cb86eaf
--- /dev/null
+++ b/gpui-pre/src/gestures/pinch.rs
@@ -0,0 +1,284 @@
+//! Touch pinches: which touches the scale recognizer ([`super::scale`], Flutter's `ScaleGestureRecognizer`) gets,
+//! and the [`PinchEvent`]s it reports. This is Flutter's gesture arena between an element's scale recognizer and
+//! the window's touch recognizer (taps, pans, long presses), as claims:
+//!
+//! - a touch joins the pinch of the deepest element with `on_pinch` under it ([`Window::join_pinch`]), unless a
+//!   deeper `on_touch` claimed it; one element pinches at a time per window;
+//! - one touch on that element stays the touch recognizer's: its pan (hit slop) always beats the scale's (pan slop);
+//! - a second touch on it hands both to the scale recognizer, the first where it is now (Flutter's recognizer
+//!   restarts its focal point and span at every new pointer anyway). Both still reach the touch recognizer, so a
+//!   two-finger tap taps and a pan keeps panning, until the scale passes its slop and wins: the touch recognizer
+//!   then cancels them (a pan ends `Cancelled`) and they reach only the pinch until they lift;
+//! - back to one touch before that, the scale gives up and waits for a second again; after it, the last finger
+//!   keeps the gesture (Flutter's one-pointer scale: `pointer_count` 1, scale 1).
+//!
+//! [`Window::join_pinch`]: crate::Window::join_pinch
+
+use std::mem;
+
+use scheduler::Instant;
+use smallvec::{SmallVec, smallvec};
+
+use super::scale::{
+    GestureDisposition, ScaleEndDetails, ScaleGestureRecognizer, ScaleOutput, ScaleStartDetails,
+    ScaleUpdateDetails,
+};
+use crate::{
+    GlobalElementId, Modifiers, PinchEvent, Pixels, Point, TouchEvent, TouchId, TouchPhase,
+};
+
+/// What a touch pinch reports in a [`PinchEvent`]: Flutter's `onStart`, `onUpdate` and `onEnd` details. A finger
+/// joining or leaving ends the gesture and the next move starts it again, as in Flutter.
+#[derive(Clone, Debug, PartialEq)]
+pub enum TouchPinch {
+    /// The touches established a focal point and an initial scale of 1 (`phase` is `Started`).
+    Start(ScaleStartDetails),
+    /// The focal point, scale or rotation changed (`phase` is `Moved`). Scale and rotation are since the start.
+    Update(ScaleUpdateDetails),
+    /// The gesture ended, with the velocity of the last finger lifted (`phase` is `Ended`).
+    End(ScaleEndDetails),
+}
+
+/// The window's touch pinch: one element's, through the stages of Flutter's arena (module docs).
+#[derive(Default)]
+pub(crate) enum PinchArena {
+    /// No touch is on a pinch element.
+    #[default]
+    Idle,
+    /// One touch on `owner`: the touch recognizer's. Its latest event is replayed when a second lands.
+    Single {
+        owner: GlobalElementId,
+        touch: TouchEvent,
+    },
+    /// Two or more touches on `owner`, each with its latest event: the scale recognizer has them, and so does the
+    /// touch recognizer until the scale wins.
+    Contested {
+        owner: GlobalElementId,
+        touches: SmallVec<[TouchEvent; 2]>,
+        scale: Box<ScaleGestureRecognizer>,
+    },
+    /// The scale won `touches`: they reach only it. `last` is the gesture's latest focal point and scale.
+    Won {
+        owner: GlobalElementId,
+        touches: SmallVec<[TouchId; 2]>,
+        scale: Box<ScaleGestureRecognizer>,
+        last: (Point<Pixels>, f32),
+    },
+}
+
+/// What the window does with one touch event, as the arena decided.
+pub(crate) struct PinchStep {
+    /// Whether the touch recognizer gets the event too.
+    pub to_recognizer: bool,
+    /// Touches the pinch just won, as `Cancelled` events: the touch recognizer drops them first.
+    pub won: SmallVec<[TouchEvent; 2]>,
+    /// The pinch events to dispatch, to the element that owns them.
+    pub pinch: Option<(GlobalElementId, Vec<PinchEvent>)>,
+}
+
+impl PinchArena {
+    /// Routes one touch event. `joins` is the pinch element its `Started` found ([`Window::join_pinch`]); later
+    /// phases ignore it. `touch_slop` is the tuning's (`GestureTuning::touch_slop`): the scale's slops follow it.
+    ///
+    /// [`Window::join_pinch`]: crate::Window::join_pinch
+    pub(crate) fn handle_event(
+        &mut self,
+        event: &TouchEvent,
+        joins: Option<&GlobalElementId>,
+        now: Instant,
+        touch_slop: Pixels,
+    ) -> PinchStep {
+        let mut step = PinchStep {
+            to_recognizer: true,
+            won: SmallVec::new(),
+            pinch: None,
+        };
+        let joins = joins.filter(|_| event.phase == TouchPhase::Started);
+        let lifted = matches!(event.phase, TouchPhase::Ended | TouchPhase::Cancelled);
+        *self = match mem::take(self) {
+            Self::Idle => match joins {
+                Some(owner) => Self::Single {
+                    owner: owner.clone(),
+                    touch: event.clone(),
+                },
+                None => Self::Idle,
+            },
+            Self::Single { owner, touch } if joins == Some(&owner) => {
+                let mut scale = Box::<ScaleGestureRecognizer>::default();
+                scale.touch_slop = Some(touch_slop);
+                let first = TouchEvent {
+                    phase: TouchPhase::Started,
+                    ..touch.clone()
+                };
+                let mut outputs = Vec::new();
+                for started in [&first, event] {
+                    scale.add_pointer(started, now);
+                    outputs.extend(scale.handle_event(started, now));
+                }
+                Self::contest(
+                    owner,
+                    smallvec![touch, event.clone()],
+                    scale,
+                    outputs,
+                    &mut step,
+                )
+            }
+            Self::Single { owner, touch } if touch.id == event.id => {
+                if lifted {
+                    Self::Idle
+                } else {
+                    Self::Single {
+                        owner,
+                        touch: event.clone(),
+                    }
+                }
+            }
+            Self::Contested {
+                owner,
+                mut touches,
+                mut scale,
+            } if joins == Some(&owner) || touches.iter().any(|touch| touch.id == event.id) => {
+                if joins.is_some() {
+                    scale.add_pointer(event, now);
+                    touches.push(event.clone());
+                } else {
+                    for touch in touches.iter_mut().filter(|touch| touch.id == event.id) {
+                        *touch = event.clone();
+                    }
+                }
+                let outputs = scale.handle_event(event, now);
+                Self::contest(owner, touches, scale, outputs, &mut step)
+            }
+            Self::Won {
+                owner,
+                mut touches,
+                mut scale,
+                mut last,
+            } if joins == Some(&owner) || touches.contains(&event.id) => {
+                step.to_recognizer = false;
+                if joins.is_some() {
+                    scale.add_pointer(event, now);
+                    touches.push(event.id);
+                }
+                let events = pinch_events(scale.handle_event(event, now), &mut last);
+                if lifted {
+                    touches.retain(|touch| *touch != event.id);
+                }
+                step.pinch = (!events.is_empty()).then(|| (owner.clone(), events));
+                if touches.is_empty() {
+                    Self::Idle
+                } else {
+                    Self::Won {
+                        owner,
+                        touches,
+                        scale,
+                        last,
+                    }
+                }
+            }
+            // A touch that is not this pinch's.
+            other @ (Self::Single { .. } | Self::Contested { .. } | Self::Won { .. }) => other,
+        };
+        step
+    }
+
+    /// The contested stage after the scale saw an event: won if it accepted, back to one touch or none if fingers
+    /// lifted (the scale gives up), still contested otherwise.
+    fn contest(
+        owner: GlobalElementId,
+        mut touches: SmallVec<[TouchEvent; 2]>,
+        scale: Box<ScaleGestureRecognizer>,
+        outputs: Vec<ScaleOutput>,
+        step: &mut PinchStep,
+    ) -> Self {
+        let accepted = outputs.iter().any(|output| {
+            matches!(
+                output,
+                ScaleOutput::Resolve {
+                    disposition: GestureDisposition::Accepted,
+                    ..
+                }
+            )
+        });
+        if accepted {
+            step.to_recognizer = false;
+            step.won = touches
+                .iter()
+                .map(|touch| TouchEvent {
+                    phase: TouchPhase::Cancelled,
+                    ..touch.clone()
+                })
+                .collect();
+            let mut last = (Point::default(), 1.0);
+            let events = pinch_events(outputs, &mut last);
+            step.pinch = (!events.is_empty()).then(|| (owner.clone(), events));
+            let touches: SmallVec<[TouchId; 2]> = touches
+                .iter()
+                .filter(|touch| !matches!(touch.phase, TouchPhase::Ended | TouchPhase::Cancelled))
+                .map(|touch| touch.id)
+                .collect();
+            return if touches.is_empty() {
+                Self::Idle
+            } else {
+                Self::Won {
+                    owner,
+                    touches,
+                    scale,
+                    last,
+                }
+            };
+        }
+        touches.retain(|touch| !matches!(touch.phase, TouchPhase::Ended | TouchPhase::Cancelled));
+        match touches.len() {
+            0 => Self::Idle,
+            1 => Self::Single {
+                owner,
+                touch: touches.remove(0),
+            },
+            _ => Self::Contested {
+                owner,
+                touches,
+                scale,
+            },
+        }
+    }
+}
+
+/// The scale's callbacks as pinch events. `position` is the focal point and `delta` the scale's change since the
+/// last event (a trackpad pinch's meaning: zoom by `1 + delta`), from `last`, the latest focal point and scale.
+fn pinch_events(outputs: Vec<ScaleOutput>, last: &mut (Point<Pixels>, f32)) -> Vec<PinchEvent> {
+    outputs
+        .into_iter()
+        .filter_map(|output| {
+            let (phase, delta, touch) = match output {
+                ScaleOutput::Resolve { .. } => return None,
+                ScaleOutput::Start(details) => {
+                    *last = (details.focal_point, 1.0);
+                    (TouchPhase::Started, 0.0, TouchPinch::Start(details))
+                }
+                ScaleOutput::Update(details) => {
+                    // Fingers that met make a zero scale: no relative change from it.
+                    let delta = if last.1 > 0.0 {
+                        details.scale / last.1 - 1.0
+                    } else {
+                        0.0
+                    };
+                    *last = (details.focal_point, details.scale);
+                    (TouchPhase::Moved, delta, TouchPinch::Update(details))
+                }
+                ScaleOutput::End(details) => (TouchPhase::Ended, 0.0, TouchPinch::End(details)),
+            };
+            Some(PinchEvent {
+                position: last.0,
+                delta,
+                modifiers: Modifiers::default(),
+                phase,
+                touch: Some(touch),
+            })
+        })
+        .collect()
+}
+
