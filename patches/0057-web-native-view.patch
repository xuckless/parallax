@@ -0,0 +1,581 @@
+// `render_content`, `ensure_content_correctly_sized`, `create_slot`, `reset_anchor` and `detach_native_view` are
+// ported from flutter/flutter engine/src/flutter/lib/web_ui/lib/src/engine/platform_views/content_manager.dart,
+// slots.dart and embedder.dart (`_resetAnchor`, `disposeView`) @ 3.50.1 (ae9b586f34a8443573f82ef57c3bf914a908cbf7).
+// Copyright 2014 The Flutter Authors. BSD-3-Clause, see third_party/flutter/LICENSE.
+
+//! Native views on the web: the app's DOM element shown under GPUI's canvas through the renderer's hole
+//! (gpui_wgpu's `native_view_hole`), placed in the frame that cuts it, with the browser giving pointer input over an
+//! uncovered view to the element itself ([`gpui::NativeViewInput::View`], as on macOS).
+//!
+//! DOM, inserted before the canvas, which is raised above it (`position: relative; z-index: 1`):
+//!
+//! ```html
+//! <gpui-native-views>                       the canvas's box; takes the pointer the canvas lets through
+//!   <div>                                   slots, in paint order
+//!     <gpui-native-view-slot>               the view's bounds clipped to its content mask
+//!       <gpui-native-view>                  the view's bounds
+//!         <the app's element />
+//!   <div>                                   shields: where GPUI's content takes input over a view
+//! ```
+//!
+//! The canvas takes the pointer except while it is over an uncovered view (`native_view_layout::step`, decided by a
+//! capture listener on the document before any element sees the event): then it is `pointer-events: none` and the
+//! browser hit-tests what is under it. A press, move or scroll that lands on the layer or a shield is GPUI's, and a
+//! copy goes to the canvas.
+
+use crate::events::EventListenerHandle;
+use crate::native_view_layout::{self, Over, Placement, PointerKind, PointerTarget};
+use crate::window::WebWindowInner;
+use gpui::{Bounds, Hsla, NativeViewId, Pixels, Point, Rgba, Scene, point, px};
+use std::{
+    any::Any,
+    cell::{Cell, RefCell},
+    rc::{Rc, Weak},
+};
+use wasm_bindgen::{JsCast, JsValue, closure::Closure};
+
+/// GPUI's callback that turns a platform's focus of a view into GPUI focus.
+type FocusedCallback = Rc<RefCell<Option<Box<dyn FnMut(NativeViewId)>>>>;
+
+#[derive(Default)]
+pub(crate) struct NativeViews {
+    /// Made with the first view.
+    layer: RefCell<Option<Layer>>,
+    slots: RefCell<Vec<Slot>>,
+    /// The occluders the shields stand for, and the shield elements, one per occluder or more (spares hidden).
+    occluders_shown: RefCell<Vec<Bounds<Pixels>>>,
+    shields: RefCell<Vec<web_sys::HtmlElement>>,
+    /// A frame placed views since the shields were last updated.
+    shields_stale: Cell<bool>,
+    target: Cell<PointerTarget>,
+    hit_test: RefCell<Option<Box<dyn FnMut(Point<Pixels>) -> Option<NativeViewId>>>>,
+    occluders: RefCell<Option<Box<dyn FnMut() -> Vec<Bounds<Pixels>>>>>,
+    focused: FocusedCallback,
+}
+
+struct Layer {
+    root: web_sys::HtmlElement,
+    slots: web_sys::HtmlElement,
+    shields: web_sys::HtmlElement,
+    /// The canvas's box last given to `root`.
+    canvas_box: Cell<[i32; 4]>,
+    _listeners: Vec<EventListenerHandle>,
+}
+
+struct Slot {
+    id: NativeViewId,
+    slot: web_sys::HtmlElement,
+    wrapper: web_sys::HtmlElement,
+    content: web_sys::HtmlElement,
+    /// Where it was last placed, its rank in paint order and its background; `None` while hidden.
+    placed: Option<(Placement, usize, Hsla)>,
+    _focus: EventListenerHandle,
+}
+
+/// Removes its view's slot from the document when the last `NativeView` handle goes.
+struct Attachment {
+    id: NativeViewId,
+    window: Weak<WebWindowInner>,
+}
+
+impl Drop for Attachment {
+    fn drop(&mut self) {
+        if let Some(window) = self.window.upgrade() {
+            window.detach_native_view(self.id);
+        }
+    }
+}
+
+/// The pointer events the document's capture listener decides on, each with how it reads one. Add a row to decide on
+/// another event.
+const POINTER_EVENTS: [(&str, fn(&web_sys::MouseEvent) -> PointerKind); 5] = [
+    ("pointermove", |event| match event.buttons() {
+        0 => PointerKind::Hover,
+        _ => PointerKind::Drag,
+    }),
+    ("pointerdown", |_| PointerKind::Press),
+    ("pointerup", release_kind),
+    ("pointercancel", release_kind),
+    ("wheel", |_| PointerKind::Wheel),
+];
+
+fn release_kind(event: &web_sys::MouseEvent) -> PointerKind {
+    match event
+        .dyn_ref::<web_sys::PointerEvent>()
+        .map(|event| event.pointer_type())
+        .as_deref()
+    {
+        Some("touch") => PointerKind::TouchRelease,
+        _ => PointerKind::Release,
+    }
+}
+
+fn set_styles(element: &web_sys::HtmlElement, styles: &[(&str, &str)]) {
+    let style = element.style();
+    for (property, value) in styles {
+        if let Err(error) = style.set_property(property, value) {
+            log::warn!("native views: cannot set {property}: {error:?}");
+        }
+    }
+}
+
+fn create(document: &web_sys::Document, tag: &str) -> Option<web_sys::HtmlElement> {
+    document
+        .create_element(tag)
+        .ok()
+        .and_then(|element| element.dyn_into().ok())
+}
+
+/// Flutter's `_resetAnchor`: transforms place the element from its top left.
+fn reset_anchor(element: &web_sys::HtmlElement) {
+    set_styles(
+        element,
+        &[
+            ("transform-origin", "0 0 0"),
+            ("position", "absolute"),
+            ("left", "0"),
+            ("top", "0"),
+        ],
+    );
+}
+
+fn place(element: &web_sys::HtmlElement, bounds: Bounds<Pixels>) {
+    let css = |value: Pixels| format!("{}px", f32::from(value));
+    set_styles(
+        element,
+        &[
+            (
+                "transform",
+                &format!(
+                    "translate({}, {})",
+                    css(bounds.origin.x),
+                    css(bounds.origin.y)
+                ),
+            ),
+            ("width", &css(bounds.size.width)),
+            ("height", &css(bounds.size.height)),
+        ],
+    );
+}
+
+/// Flutter's `_ensureContentCorrectlySized`: fills the slot unless the app sized the element.
+fn ensure_content_correctly_sized(content: &web_sys::HtmlElement) {
+    let style = content.style();
+    for property in ["height", "width"] {
+        if style
+            .get_property_value(property)
+            .unwrap_or_default()
+            .is_empty()
+        {
+            log::warn!(
+                "native views: {property} of the view's element is not set; defaulting to 100%"
+            );
+            set_styles(content, &[(property, "100%")]);
+        }
+    }
+}
+
+impl NativeViews {
+    pub(crate) fn target(&self) -> PointerTarget {
+        self.target.get()
+    }
+
+    pub(crate) fn set_hit_test(
+        &self,
+        callback: Box<dyn FnMut(Point<Pixels>) -> Option<NativeViewId>>,
+    ) {
+        *self.hit_test.borrow_mut() = Some(callback);
+    }
+
+    pub(crate) fn set_occluders(&self, callback: Box<dyn FnMut() -> Vec<Bounds<Pixels>>>) {
+        *self.occluders.borrow_mut() = Some(callback);
+    }
+
+    pub(crate) fn set_focused(&self, callback: Box<dyn FnMut(NativeViewId)>) {
+        *self.focused.borrow_mut() = Some(callback);
+    }
+
+    fn shows_views(&self) -> bool {
+        self.slots.borrow().iter().any(|slot| slot.placed.is_some())
+    }
+
+    /// Takes the callback out while it runs, so GPUI re-entering the window finds no borrow.
+    fn hit_test_at(&self, position: Point<Pixels>) -> Option<NativeViewId> {
+        let mut callback = self.hit_test.borrow_mut().take()?;
+        let id = callback(position);
+        *self.hit_test.borrow_mut() = Some(callback);
+        id
+    }
+
+    fn set_target(&self, target: PointerTarget, canvas: &web_sys::HtmlCanvasElement) {
+        if self.target.replace(target) == target {
+            return;
+        }
+        let pointer_events = match target {
+            PointerTarget::Canvas => "auto",
+            PointerTarget::Views => "none",
+        };
+        set_styles(canvas, &[("pointer-events", pointer_events)]);
+    }
+}
+
+impl WebWindowInner {
+    pub(crate) fn attach_native_view(
+        self: &Rc<Self>,
+        id: NativeViewId,
+        content: web_sys::HtmlElement,
+    ) -> Option<Box<dyn Any>> {
+        let document = self.browser_window.document()?;
+        if self.native_views.layer.borrow().is_none() {
+            let layer = self.create_layer(&document)?;
+            *self.native_views.layer.borrow_mut() = Some(layer);
+        }
+        let slot = self.render_content(&document, id, content)?;
+        self.native_views.slots.borrow_mut().push(slot);
+        Some(Box::new(Attachment {
+            id,
+            window: Rc::downgrade(self),
+        }))
+    }
+
+    fn create_layer(self: &Rc<Self>, document: &web_sys::Document) -> Option<Layer> {
+        let root = create(document, "gpui-native-views")?;
+        let slots = create(document, "div")?;
+        let shields = create(document, "div")?;
+        set_styles(
+            &root,
+            &[
+                ("position", "absolute"),
+                ("z-index", "0"),
+                ("overflow", "hidden"),
+                ("touch-action", "none"),
+                ("user-select", "none"),
+                ("-webkit-user-select", "none"),
+            ],
+        );
+        for (container, z_index) in [(&slots, "0"), (&shields, "1")] {
+            set_styles(
+                container,
+                &[
+                    ("position", "absolute"),
+                    ("inset", "0"),
+                    ("z-index", z_index),
+                    ("pointer-events", "none"),
+                ],
+            );
+            root.append_child(container).ok()?;
+        }
+        self.canvas
+            .parent_node()?
+            .insert_before(&root, Some(&self.canvas))
+            .ok()?;
+        set_styles(&self.canvas, &[("position", "relative"), ("z-index", "1")]);
+
+        let listeners = POINTER_EVENTS
+            .iter()
+            .map(|&(event_name, kind)| {
+                let window = Rc::downgrade(self);
+                EventListenerHandle::add_capture(document.as_ref(), event_name, move |event| {
+                    if let Some(window) = window.upgrade() {
+                        let event: web_sys::MouseEvent = event.unchecked_into();
+                        window.decide_native_view_pointer(&event, kind(&event));
+                    }
+                })
+            })
+            .collect();
+        Some(Layer {
+            root,
+            slots,
+            shields,
+            canvas_box: Cell::new([0; 4]),
+            _listeners: listeners,
+        })
+    }
+
+    /// Flutter's `renderContent` and `createPlatformViewSlot`. Flutter's slot reveals the content through a
+    /// `<slot>` in its shadow root; the canvas here has none, so the slot holds the content's wrapper itself.
+    fn render_content(
+        &self,
+        document: &web_sys::Document,
+        id: NativeViewId,
+        content: web_sys::HtmlElement,
+    ) -> Option<Slot> {
+        let slot = create(document, "gpui-native-view-slot")?;
+        set_styles(
+            &slot,
+            &[
+                ("pointer-events", "auto"),
+                ("overflow", "hidden"),
+                ("display", "none"),
+            ],
+        );
+        reset_anchor(&slot);
+        let wrapper = create(document, "gpui-native-view")?;
+        reset_anchor(&wrapper);
+        ensure_content_correctly_sized(&content);
+        wrapper.append_child(&content).ok()?;
+        slot.append_child(&wrapper).ok()?;
+        self.native_views
+            .layer
+            .borrow()
+            .as_ref()?
+            .slots
+            .append_child(&slot)
+            .ok()?;
+        let focused = Rc::clone(&self.native_views.focused);
+        let focus = EventListenerHandle::add(slot.as_ref(), "focusin", move |_| {
+            let callback = focused.borrow_mut().take();
+            if let Some(mut callback) = callback {
+                callback(id);
+                *focused.borrow_mut() = Some(callback);
+            }
+        });
+        Some(Slot {
+            id,
+            slot,
+            wrapper,
+            content,
+            placed: None,
+            _focus: focus,
+        })
+    }
+
+    /// Flutter's `clearPlatformView` / `disposeView`: the slot leaves the document with the content in it.
+    fn detach_native_view(&self, id: NativeViewId) {
+        self.native_views.slots.borrow_mut().retain(|slot| {
+            if slot.id == id {
+                slot.slot.remove();
+            }
+            slot.id != id
+        });
+        if !self.native_views.shows_views() {
+            self.native_views
+                .set_target(PointerTarget::Canvas, &self.canvas);
+        }
+    }
+
+    /// Places every view as `scene` shows it, before the scene is drawn: the DOM changes and the canvas reach the
+    /// screen in the same browser frame. A view whose placement is unchanged is not touched.
+    pub(crate) fn place_native_views(&self, scene: &Scene) {
+        let mut slots = self.native_views.slots.borrow_mut();
+        if slots.is_empty() {
+            return;
+        }
+        let layer = self.native_views.layer.borrow();
+        let Some(layer) = layer.as_ref() else {
+            return;
+        };
+        let canvas_box = [
+            self.canvas.offset_left(),
+            self.canvas.offset_top(),
+            self.canvas.offset_width(),
+            self.canvas.offset_height(),
+        ];
+        if layer.canvas_box.replace(canvas_box) != canvas_box {
+            let [left, top, width, height] = canvas_box.map(|value| px(value as f32));
+            place(
+                &layer.root,
+                Bounds::new(point(left, top), gpui::size(width, height)),
+            );
+        }
+        let scale_factor = self.state.borrow().scale_factor;
+        let showed = slots.iter().any(|slot| slot.placed.is_some());
+        for slot in slots.iter_mut() {
+            let shown = scene
+                .native_views
+                .iter()
+                .enumerate()
+                .find(|(_, native_view)| native_view.id == slot.id)
+                .map(|(rank, native_view)| {
+                    (
+                        native_view_layout::placement(native_view, scale_factor),
+                        rank,
+                        native_view.background,
+                    )
+                });
+            if shown == slot.placed {
+                continue;
+            }
+            match shown {
+                Some((placement, rank, background)) => {
+                    place(&slot.slot, placement.slot);
+                    place(&slot.wrapper, placement.view);
+                    // `NativeView::set_background`: shows where the element has not caught up with its slot,
+                    // as a cross-origin iframe's own process does for a frame after a resize.
+                    let Rgba { r, g, b, a } = background.into();
+                    let background = format!("rgba({}, {}, {}, {a})", r * 255., g * 255., b * 255.);
+                    set_styles(
+                        &slot.slot,
+                        &[
+                            ("display", ""),
+                            ("z-index", &rank.to_string()),
+                            ("background-color", &background),
+                        ],
+                    );
+                }
+                None => set_styles(&slot.slot, &[("display", "none")]),
+            }
+            slot.placed = shown;
+        }
+        let shows = slots.iter().any(|slot| slot.placed.is_some());
+        drop(slots);
+        self.native_views.shields_stale.set(true);
+        // Views that start to show take the pointer until it is seen over GPUI's content: a touch has no hover
+        // to switch on, so its first tap must find the element. The layer sends anything else back.
+        match (showed, shows) {
+            (false, true) => self
+                .native_views
+                .set_target(PointerTarget::Views, &self.canvas),
+            (true | false, false) => self
+                .native_views
+                .set_target(PointerTarget::Canvas, &self.canvas),
+            (true, true) => {}
+        }
+    }
+
+    /// After a frame that placed views, outside GPUI's update: a shield over each region of a view where GPUI's
+    /// content takes input, so the browser hit-tests the pointer there to GPUI's layer, not the view's element.
+    pub(crate) fn update_native_view_shields(&self) {
+        if !self.native_views.shields_stale.replace(false) {
+            return;
+        }
+        let occluders = {
+            let Some(mut callback) = self.native_views.occluders.borrow_mut().take() else {
+                return;
+            };
+            let occluders = callback();
+            *self.native_views.occluders.borrow_mut() = Some(callback);
+            occluders
+        };
+        if *self.native_views.occluders_shown.borrow() == occluders {
+            return;
+        }
+        let layer = self.native_views.layer.borrow();
+        let (Some(layer), Some(document)) = (layer.as_ref(), self.browser_window.document()) else {
+            return;
+        };
+        let mut shields = self.native_views.shields.borrow_mut();
+        while shields.len() < occluders.len() {
+            let Some(shield) = create(&document, "div") else {
+                return;
+            };
+            reset_anchor(&shield);
+            set_styles(&shield, &[("pointer-events", "auto")]);
+            if layer.shields.append_child(&shield).is_err() {
+                return;
+            }
+            shields.push(shield);
+        }
+        for (index, shield) in shields.iter().enumerate() {
+            match occluders.get(index) {
+                Some(occluder) => {
+                    place(shield, *occluder);
+                    set_styles(shield, &[("display", "")]);
+                }
+                None => set_styles(shield, &[("display", "none")]),
+            }
+        }
+        drop(shields);
+        *self.native_views.occluders_shown.borrow_mut() = occluders;
+    }
+
+    /// The document's capture listener, ahead of every element: which of the canvas and what is under it takes the
+    /// pointer from now on, and whether this event is GPUI's after all.
+    fn decide_native_view_pointer(&self, event: &web_sys::MouseEvent, kind: PointerKind) {
+        // A copy sent to the canvas comes through here too, already decided.
+        if !event.is_trusted() || !self.native_views.shows_views() {
+            return;
+        }
+        let canvas = self.canvas.get_bounding_client_rect();
+        let position = point(
+            px((f64::from(event.client_x()) - canvas.left()) as f32),
+            px((f64::from(event.client_y()) - canvas.top()) as f32),
+        );
+        self.state.borrow_mut().mouse_position = position;
+        let over = match kind {
+            // A drag stays with its press's target, wherever it is.
+            PointerKind::Drag => Over::Window,
+            PointerKind::Hover
+            | PointerKind::Press
+            | PointerKind::Wheel
+            | PointerKind::Release
+            | PointerKind::TouchRelease => match self.native_views.hit_test_at(position) {
+                Some(_) => Over::View,
+                None => Over::Window,
+            },
+        };
+        let on_canvas = event
+            .target()
+            .is_some_and(|target| js_sys::Object::is(&target, &self.canvas));
+        let step = native_view_layout::step(self.native_views.target(), kind, over, on_canvas);
+        self.native_views.set_target(step.target, &self.canvas);
+        if !step.forward {
+            return;
+        }
+        event.prevent_default();
+        event.stop_propagation();
+        // The copy is the event's own constructor with the event itself as its init dictionary, which keeps every
+        // field (pointer id, buttons, deltas). It is dispatched in a microtask, right after this listener returns:
+        // dispatching it from here would run this listener (a wasm-bindgen `FnMut`) inside itself, which throws.
+        let copy = js_sys::Reflect::get(event, &JsValue::from_str("constructor"))
+            .ok()
+            .and_then(|constructor| constructor.dyn_into::<js_sys::Function>().ok())
+            .and_then(|constructor| {
+                let arguments = js_sys::Array::of2(&JsValue::from(event.type_()), event);
+                js_sys::Reflect::construct(&constructor, &arguments).ok()
+            });
+        let queue_microtask =
+            js_sys::Reflect::get(&js_sys::global(), &JsValue::from_str("queueMicrotask"))
+                .ok()
+                .and_then(|queue| queue.dyn_into::<js_sys::Function>().ok());
+        let (Some(copy), Some(queue_microtask)) = (copy, queue_microtask) else {
+            log::warn!(
+                "native views: cannot copy a {} event to the canvas",
+                event.type_()
+            );
+            return;
+        };
+        let canvas = self.canvas.clone();
+        let dispatch = Closure::once_into_js(move || {
+            canvas.dispatch_event(copy.unchecked_ref()).ok();
+        });
+        queue_microtask.call1(&JsValue::UNDEFINED, &dispatch).ok();
+    }
+
+    /// Gives the view's element DOM focus, or takes it back to GPUI's own input element.
+    pub(crate) fn focus_native_view(&self, id: Option<NativeViewId>) {
+        // GPUI moved its focus; the element's `focusin` must not report it back.
+        let callback = self.native_views.focused.borrow_mut().take();
+        match id {
+            Some(id) => {
+                if let Some(slot) = self
+                    .native_views
+                    .slots
+                    .borrow()
+                    .iter()
+                    .find(|slot| slot.id == id)
+                {
+                    slot.content.focus().ok();
+                }
+            }
+            None => {
+                let in_view = self
+                    .browser_window
+                    .document()
+                    .and_then(|document| document.active_element())
+                    .zip(
+                        self.native_views
+                            .layer
+                            .borrow()
+                            .as_ref()
+                            .map(|layer| layer.root.clone()),
+                    )
+                    .is_some_and(|(active, root)| root.contains(Some(&active)));
+                if in_view {
+                    self.ime_mirror.focus();
+                }
+            }
+        }
+        *self.native_views.focused.borrow_mut() = callback;
+    }
+}
