--- /dev/null
+++ b/gpui-pre-web/src/native_view_layout.rs
@@ -0,0 +1,230 @@
+//! Native views on the web, the decisions: where a view's DOM element goes under the canvas, and whether the canvas
+//! or the element under it takes the pointer. Pure, so it is tested on any host; `native_views.rs` is the DOM shell.
+
+use gpui::{Bounds, PaintNativeView, Pixels, ScaledPixels, point, px, size};
+
+/// Where a shown view's elements go, in CSS pixels: its slot (the view's bounds clipped to its content mask, from the
+/// canvas's top left) and the view's own box inside the slot.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct Placement {
+    pub(crate) slot: Bounds<Pixels>,
+    pub(crate) view: Bounds<Pixels>,
+}
+
+/// Both boxes are rounded outwards to whole device pixels: the renderer's hole covers exactly the device pixels whose
+/// centres are inside the view, so an element covering every pixel the bounds touch leaves no seam at a fractional
+/// scale (the canvas hides the overhang).
+pub(crate) fn placement(native_view: &PaintNativeView, scale_factor: f32) -> Placement {
+    let outwards = |bounds: Bounds<ScaledPixels>| {
+        let left = bounds.origin.x.0.floor();
+        let top = bounds.origin.y.0.floor();
+        let right = (bounds.origin.x.0 + bounds.size.width.0).ceil();
+        let bottom = (bounds.origin.y.0 + bounds.size.height.0).ceil();
+        Bounds::new(
+            point(px(left / scale_factor), px(top / scale_factor)),
+            size(
+                px((right - left).max(0.) / scale_factor),
+                px((bottom - top).max(0.) / scale_factor),
+            ),
+        )
+    };
+    let slot = outwards(
+        native_view
+            .bounds
+            .intersect(&native_view.content_mask.bounds),
+    );
+    let view = outwards(native_view.bounds);
+    Placement {
+        slot,
+        view: Bounds::new(view.origin - slot.origin, view.size),
+    }
+}
+
+/// Who the browser hit-tests the pointer to while a view shows: GPUI's canvas, or what is under it (the canvas's
+/// `pointer-events: none`), where an uncovered view's element takes trusted events of its own (an iframe's clicks
+/// and scrolls, a video's controls) and the native view layer and its shields take the rest back for GPUI.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) enum PointerTarget {
+    /// The canvas's own `pointer-events: auto`, before any view shows.
+    #[default]
+    Canvas,
+    Views,
+}
+
+/// A pointer event seen by the document's capture listener.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum PointerKind {
+    /// `pointermove` with no button pressed.
+    Hover,
+    /// `pointermove` with a button pressed: the press's target keeps it.
+    Drag,
+    Press,
+    Wheel,
+    /// A mouse or pen `pointerup` / `pointercancel`.
+    Release,
+    /// A touch `pointerup` / `pointercancel`: a touch has no hover to switch on, so the next one must find the
+    /// view's element, and the layer and shields send it back if it lands on GPUI's content.
+    TouchRelease,
+}
+
+/// What GPUI's hit test says is at the pointer (`hit_test_native_view`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Over {
+    /// A view with no GPUI hitbox above it there.
+    View,
+    Window,
+}
+
+/// What the capture listener does with an event.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Step {
+    pub(crate) target: PointerTarget,
+    /// Send a copy to the canvas: the browser gave the event to the layer or a shield, but GPUI's content is there.
+    pub(crate) forward: bool,
+}
+
+/// `current × event → step`. `on_canvas`: the browser gave the event to the canvas. Extend by adding a `PointerKind`
+/// and its arm; every arm is explicit.
+pub(crate) fn step(current: PointerTarget, kind: PointerKind, over: Over, on_canvas: bool) -> Step {
+    let to = |target, forward| Step { target, forward };
+    match (kind, over) {
+        (PointerKind::Drag, Over::View | Over::Window) => to(current, false),
+        (PointerKind::TouchRelease, Over::View | Over::Window) => to(PointerTarget::Views, false),
+        (
+            PointerKind::Hover | PointerKind::Press | PointerKind::Wheel | PointerKind::Release,
+            Over::View,
+        ) => to(PointerTarget::Views, false),
+        (PointerKind::Hover | PointerKind::Press | PointerKind::Wheel, Over::Window) => {
+            to(PointerTarget::Canvas, !on_canvas)
+        }
+        // A release off the canvas ends a press GPUI never had (the press's target captured it otherwise).
+        (PointerKind::Release, Over::Window) => to(PointerTarget::Canvas, false),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use gpui::{ContentMask, HitboxId, Hsla, NativeViewId};
+
+    fn view(bounds: [f32; 4], mask: [f32; 4]) -> PaintNativeView {
+        let scaled = |[x, y, width, height]: [f32; 4]| Bounds {
+            origin: point(ScaledPixels(x), ScaledPixels(y)),
+            size: size(ScaledPixels(width), ScaledPixels(height)),
+        };
+        PaintNativeView {
+            order: 0,
+            id: NativeViewId::for_test(1),
+            hitbox_id: HitboxId::placeholder(),
+            bounds: scaled(bounds),
+            content_mask: ContentMask {
+                bounds: scaled(mask),
+            },
+            background: Hsla::default(),
+        }
+    }
+
+    fn css([x, y, width, height]: [f32; 4]) -> Bounds<Pixels> {
+        Bounds::new(point(px(x), px(y)), size(px(width), px(height)))
+    }
+
+    #[test]
+    fn placement_of_a_view() {
+        let everything = [0., 0., 10_000., 10_000.];
+        // (row name, view bounds and content mask in device pixels, scale, slot and view in CSS pixels). Add a row
+        // per rule.
+        let rows: [(&str, [f32; 4], [f32; 4], f32, [f32; 4], [f32; 4]); 4] = [
+            (
+                "whole pixels at 1",
+                [10., 20., 300., 200.],
+                everything,
+                1.,
+                [10., 20., 300., 200.],
+                [0., 0., 300., 200.],
+            ),
+            (
+                "whole device pixels at 1.25",
+                [125., 250., 375., 250.],
+                everything,
+                1.25,
+                [100., 200., 300., 200.],
+                [0., 0., 300., 200.],
+            ),
+            (
+                "fractional device pixels round outwards",
+                [12.5, 20.4, 100., 50.],
+                everything,
+                1.25,
+                [9.6, 16., 80.8, 40.8],
+                [0., 0., 80.8, 40.8],
+            ),
+            (
+                "the content mask clips the slot, the view keeps its size",
+                [0., 0., 200., 100.],
+                [50., 0., 100., 100.],
+                1.,
+                [50., 0., 100., 100.],
+                [-50., 0., 200., 100.],
+            ),
+        ];
+        for (name, bounds, mask, scale, slot, view_box) in rows {
+            let placement = placement(&view(bounds, mask), scale);
+            let close = |a: Bounds<Pixels>, b: Bounds<Pixels>| {
+                [
+                    (a.origin.x, b.origin.x),
+                    (a.origin.y, b.origin.y),
+                    (a.size.width, b.size.width),
+                    (a.size.height, b.size.height),
+                ]
+                .iter()
+                .all(|(a, b)| (f32::from(*a) - f32::from(*b)).abs() < 1e-4)
+            };
+            assert!(
+                close(placement.slot, css(slot)),
+                "{name}: slot {:?}",
+                placement.slot
+            );
+            assert!(
+                close(placement.view, css(view_box)),
+                "{name}: view {:?}",
+                placement.view
+            );
+        }
+    }
+
+    #[test]
+    fn pointer_target_steps() {
+        use Over::{View, Window};
+        use PointerKind::*;
+        use PointerTarget::{Canvas, Views};
+        // (row name, current, event, over, on the canvas, next target, forwarded). One row per (state, event).
+        #[rustfmt::skip]
+        let rows = [
+            ("hover onto an uncovered view", Canvas, Hover, View, true, Views, false),
+            ("hover within a view's element", Views, Hover, View, false, Views, false),
+            ("hover onto GPUI's content from a view", Views, Hover, Window, false, Canvas, true),
+            ("hover over GPUI's content", Canvas, Hover, Window, true, Canvas, false),
+            ("drag from the canvas over a view", Canvas, Drag, View, true, Canvas, false),
+            ("drag from a view over GPUI's content", Views, Drag, Window, false, Views, false),
+            ("press on a view the canvas still had", Canvas, Press, View, true, Views, false),
+            ("press on a view's element", Views, Press, View, false, Views, false),
+            ("press on a shield over a view", Views, Press, Window, false, Canvas, true),
+            ("press on GPUI's content", Canvas, Press, Window, true, Canvas, false),
+            ("wheel over a view's element", Views, Wheel, View, false, Views, false),
+            ("wheel over a shield", Views, Wheel, Window, false, Canvas, true),
+            ("wheel over GPUI's content", Canvas, Wheel, Window, true, Canvas, false),
+            ("mouse release over a view", Canvas, Release, View, true, Views, false),
+            ("mouse release off the canvas", Views, Release, Window, false, Canvas, false),
+            ("mouse release on the canvas", Canvas, Release, Window, true, Canvas, false),
+            ("touch release on GPUI's content", Canvas, TouchRelease, Window, true, Views, false),
+            ("touch release on a view", Views, TouchRelease, View, false, Views, false),
+        ];
+        for (name, current, kind, over, on_canvas, target, forward) in rows {
+            assert_eq!(
+                step(current, kind, over, on_canvas),
+                Step { target, forward },
+                "{name}"
+            );
+        }
+    }
+}
