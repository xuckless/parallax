+    fn steps() {
+        let a = whole(rect(0, 0, 10, 10));
+        let b = whole(rect(5, 0, 10, 10));
+        let cropped = Shown {
+            bounds: rect(0, 5, 10, 5),
+            crop: Crop::Part(fractions(0., 0.5, 1., 0.5)),
