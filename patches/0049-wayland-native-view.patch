+    /// Tells GPUI the size, in pixels, of the buffers the app commits to the
+    /// view. Only Wayland uses it, and needs it there to show a view its
+    /// element's clip cuts (a view scrolled partly out of its container): every
+    /// platform shows only the part of the view the clip leaves, at the view's
+    /// full size and position, and on Wayland GPUI does that by cropping the
+    /// app's buffer, which takes knowing its size. Without it, a clipped view
+    /// shows whole on Wayland.
+    ///
+    /// Call it from the main thread when the size changes, before committing
+    /// the first buffer of the new size, and commit none of the old size after
+    /// it: the crop for the new size goes to the view at once, so it shows
+    /// with that buffer.
+    pub fn set_buffer_size(&self, size: crate::Size<crate::DevicePixels>, window: &mut Window) {
+        if self.0.window == window.handle
+            && window
+                .platform_window
+                .set_native_view_buffer_size(self.0.id, size)
+        {
+            window.refresh();
+        }
+    }
