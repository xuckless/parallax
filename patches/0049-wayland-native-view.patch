+        // (row name, placement, where the frame shows the view, step)
+        let rows = [
+            (
+                "unmapped and not painted",
+                Placement::Unmapped,
+                None,
+                Step::Keep,
+            ),
+            (
+                "first paint shows",
+                Placement::Unmapped,
+                Some(a),
+                Step::Show(a),
+            ),
+            ("same bounds keep", Placement::Shown(a), Some(a), Step::Keep),
+            (
+                "new bounds move",
+                Placement::Shown(a),
+                Some(b),
+                Step::Move(b),
+            ),
+            ("not painted hides", Placement::Shown(a), None, Step::Hide),
+            (
+                "hidden and not painted",
+                Placement::Hidden,
+                None,
+                Step::Keep,
+            ),
+            (
+                "painted again shows",
+                Placement::Hidden,
+                Some(b),
+                Step::Show(b),
+            ),
+            (
+                "a new crop moves",
+                Placement::Shown(a),
+                Some(cropped),
+                Step::Move(cropped),
