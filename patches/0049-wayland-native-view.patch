+        let lower_half = Shown {
+            bounds: rect(100, 80, 640, 200),
+            crop: Crop::Part(fractions(0., 0.5, 1., 0.5)),
+        };
+        // (row name, view bounds, clip, scale, what shows)
+        let rows = [
+            (
+                "unclipped shows whole",
+                view(1.),
+                physical(0., -200., 1000., 1000.),
+                1.0,
+                Some(whole(rect(100, -120, 640, 400))),
+            ),
+            (
+                "half scrolled out shows the lower half",
+                view(1.),
+                clip(1.),
+                1.0,
+                Some(lower_half),
+            ),
+            (
+                "half scrolled out at 1.25",
+                view(1.25),
+                clip(1.25),
+                1.25,
+                Some(lower_half),
+            ),
+            (
+                "a clip partway through a logical pixel rounds outwards",
+                view(1.25),
+                physical(125., 101., 800., 249.),
+                1.25,
+                Some(lower_half),
+            ),
+            (
+                "clipped on the left at 2",
+                physical(0., 0., 400., 200.),
+                physical(100., 0., 400., 200.),
+                2.0,
+                Some(Shown {
+                    bounds: rect(50, 0, 150, 100),
+                    crop: Crop::Part(fractions(0.25, 0., 0.75, 1.)),
+                }),
+            ),
+            (
+                "scrolled out of the clip shows nothing",
+                view(1.),
+                physical(100., 400., 640., 200.),
+                1.0,
+                None,
+            ),
+        ];
+        for (name, bounds, clip, scale, expected) in rows {
+            assert_eq!(shown(&painted(bounds, clip), scale), expected, "{name}");
+        }
+    }
+
+    #[test]
+    fn frames_stack_views_in_paint_order_over_an_underlay() {
+        let red = gpui::hsla(0., 1., 0.5, 1.);
+        let clear = gpui::Hsla::transparent_black();
+        let screen = physical(0., 0., 1000., 1000.);
+        let view = |id: u64, x: f32, background| PaintNativeView {
+            id: NativeViewId::for_test(id),
+            background,
+            ..painted(physical(x, 0., 10., 10.), screen)
+        };
+        let scene = |views: Vec<PaintNativeView>| {
+            let mut scene = Scene::default();
+            for view in views {
+                scene.insert_primitive(view);
+            }
+            scene.finish();
+            scene
+        };
+        let at = |x: i32| whole(rect(x, 0, 10, 10));
+        let opaque = WindowBackgroundAppearance::Opaque;
+        // (row name, scene views in paint order, appearance, frame)
+        let rows = [
+            ("no views", vec![], opaque, Frame::default()),
+            (
+                "back to front, no colour asked, no underlay",
+                vec![view(2, 0., clear), view(1, 20., clear)],
+                opaque,
+                Frame {
+                    views: vec![
+                        (NativeViewId::for_test(2), at(0)),
+                        (NativeViewId::for_test(1), at(20)),
+                    ],
+                    underlay: None,
+                },
+            ),
+            (
+                "an opaque window's underlay covers every view",
+                vec![view(1, 0., red), view(2, 20., clear)],
+                opaque,
+                Frame {
+                    views: vec![
+                        (NativeViewId::for_test(1), at(0)),
+                        (NativeViewId::for_test(2), at(20)),
+                    ],
+                    underlay: Some((rect(0, 0, 30, 10), Rgba::from(red))),
+                },
+            ),
+            (
+                "a see-through window shows what is behind it",
+                vec![view(1, 0., red)],
+                WindowBackgroundAppearance::Transparent,
+                Frame {
+                    views: vec![(NativeViewId::for_test(1), at(0))],
+                    underlay: None,
+                },
+            ),
+        ];
+        for (name, views, appearance, expected) in rows {
+            assert_eq!(
+                Frame::new(&scene(views), 1., appearance),
+                expected,
+                "{name}"
+            );
+        }
+    }
+
+    #[test]
+    fn sources_stay_inside_the_buffer() {
+        // (row name, part of the view, buffer size, source in buffer pixels)
+        let rows = [
+            (
+                "the lower half",
+                fractions(0., 0.5, 1., 0.5),
+                size(640, 400),
+                rect(0, 200, 640, 200),
+            ),
+            (
+                "the same part of a bigger buffer",
+                fractions(0., 0.5, 1., 0.5),
+                size(1280, 800),
+                rect(0, 400, 1280, 400),
+            ),
+            (
+                "the same part of a smaller buffer, as after a resize",
+                fractions(0., 0.5, 1., 0.5),
+                size(320, 200),
+                rect(0, 100, 320, 100),
+            ),
+            (
+                "partial pixels round outwards",
+                fractions(0.125, 0.25, 0.5, 0.5),
+                size(20, 10),
+                rect(2, 2, 11, 6),
+            ),
+            (
+                "a sliver is one pixel",
+                fractions(0.5, 0.999, 0.0001, 0.001),
+                size(100, 100),
+                rect(50, 99, 1, 1),
+            ),
+            (
+                "an empty buffer is one pixel",
+                fractions(0., 0.5, 1., 0.5),
+                size(0, 0),
+                rect(0, 0, 1, 1),
+            ),
+        ];
+        for (name, part, buffer, expected) in rows {
+            assert_eq!(source(part, buffer), expected, "{name}");
+        }
+    }
+}
