+/// as a [`TouchEvent`] and GPUI makes its own mouse events from it, so a tap clicks once) or from a smooth-scroll
+/// valuator (dropped: its motion event scrolls). winit's `xinput2_button_input` check.
+pub(crate) fn is_pointer_emulated(flags: xinput::PointerEventFlags) -> bool {
+    flags.contains(xinput::PointerEventFlags::POINTER_EMULATED)
+}
+
+/// GPUI's clock and the X server's event clock read together, so an event's `time` becomes a GPUI `Instant` by its
+/// age, as [`TouchEvent::time_stamp`] wants.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct X11Clock {
+    pub(crate) now: Instant,
+    /// The X server's clock at `now`, in ms. Xorg and Xwayland stamp events with `CLOCK_MONOTONIC` in ms, wrapping
+    /// at `u32` (`GetTimeInMillis`), so this reads the local monotonic clock the same way.
+    pub(crate) server_millis: xproto::Timestamp,
+}
+
+impl X11Clock {
+    /// An age past this, either way, means the server stamps on another clock (a remote display): no time stamp.
+    const FOREIGN_CLOCK_MILLIS: u32 = 10_000;
+
+    pub(crate) fn read() -> Self {
+        let mut time = libc::timespec {
+            tv_sec: 0,
+            tv_nsec: 0,
+        };
+        // SAFETY: `time` is a valid, writable timespec, and CLOCK_MONOTONIC exists on every Linux and FreeBSD.
+        unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut time) };
+        Self {
+            now: Instant::now(),
+            // Truncating to u32 wraps as the server's CARD32 time does.
+            server_millis: (time.tv_sec as u64 * 1000 + time.tv_nsec as u64 / 1_000_000) as u32,
+        }
+    }
+
+    /// When an event stamped `time` happened, on GPUI's clock. A stamp a little after the clock read counts as now;
+    /// one too far either way is from another clock.
+    fn at(self, time: xproto::Timestamp) -> Option<Instant> {
+        // The wrapping difference read as signed, so an age across the u32 wrap stays small.
+        let age = self.server_millis.wrapping_sub(time) as i32;
+        if age.unsigned_abs() > Self::FOREIGN_CLOCK_MILLIS {
+            return None;
+        }
+        self.now
+            .checked_sub(Duration::from_millis(age.max(0) as u64))
+    }
+}
+
+/// The GPUI touch for an XI2 touch event (winit's `xinput2_touch`), in logical pixels at `scale_factor`. XI2 touch
+/// ids are globally unique and increase for each new touch (XI2proto), so the detail is the [`TouchId`]. `None` for
+/// an event type without an [`XI2_TOUCH_PHASES`] row.
+pub(crate) fn touch_from_xinput(
+    event: &xinput::TouchBeginEvent,
+    scale_factor: f32,
+    clock: X11Clock,
+) -> Option<TouchEvent> {
+    let (_, phase) = XI2_TOUCH_PHASES
+        .iter()
+        .find(|(event_type, _)| *event_type == event.event_type)?;
+    Some(TouchEvent {
+        id: TouchId(u64::from(event.detail)),
+        phase: *phase,
+        // Converted as client.rs converts pointer positions, so touch and mouse agree.
+        position: point(
+            px(event.event_x as f32 / u16::MAX as f32 / scale_factor),
+            px(event.event_y as f32 / u16::MAX as f32 / scale_factor),
+        ),
+        predicted_position: None,
+        // winit leaves force a TODO: XI2 reports pressure only as a per-device valuator.
+        force: None,
+        device: PointerDevice::Touch,
+        time_stamp: clock.at(event.time),
+    })
+}
