@@ -0,0 +1,66 @@
+//! Who gets pointer input over a native view, per platform (`PlatformWindow::native_view_input`).
+
+use crate::HitboxBehavior;
+
+/// Who a platform gives pointer input over a shown native view to.
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub enum NativeViewInput {
+    /// The view itself, as on macOS, where AppKit hit-tests the `NSView`.
+    /// The view's element blocks the mouse from everything behind it.
+    View,
+    /// The window's own content, as on iOS (GPUI's view stays on top and
+    /// takes every touch), Windows and Wayland (the view takes no input). The view's element is hit-tested like any
+    /// other, so its ancestors' listeners hear the input; the view hears
+    /// nothing unless the app forwards it.
+    Window,
+}
+
+impl NativeViewInput {
+    /// The hitbox behavior of a native view's element, which blocks the mouse
+    /// only where the platform gives the input to the view instead of GPUI.
+    pub(super) fn hitbox_behavior(self, shows_view: bool) -> HitboxBehavior {
+        match (self, shows_view) {
+            (NativeViewInput::View, true) => HitboxBehavior::BlockMouse,
+            (NativeViewInput::View, false) | (NativeViewInput::Window, _) => HitboxBehavior::Normal,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_native_view_blocks_the_mouse_only_where_the_view_takes_the_input() {
+        // (name, input, shows view, behavior)
+        let cases = [
+            (
+                "macOS, shown",
+                NativeViewInput::View,
+                true,
+                HitboxBehavior::BlockMouse,
+            ),
+            (
+                "macOS, shown elsewhere",
+                NativeViewInput::View,
+                false,
+                HitboxBehavior::Normal,
+            ),
+            (
+                "iOS, shown",
+                NativeViewInput::Window,
+                true,
+                HitboxBehavior::Normal,
+            ),
+            (
+                "iOS, shown elsewhere",
+                NativeViewInput::Window,
+                false,
+                HitboxBehavior::Normal,
+            ),
+        ];
+        for (name, input, shows_view, behavior) in cases {
+            assert_eq!(input.hitbox_behavior(shows_view), behavior, "{name}");
+        }
+    }
+}
