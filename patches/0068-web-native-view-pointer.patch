+        (TouchRelease, Over::View | Over::Window, Hit::Canvas | Hit::Cover | Hit::Element) => {
+            to(PointerTarget::Views, Send::Nothing)
+        }
+        (Hover | Press | Wheel | Release, Over::View, Hit::Canvas | Hit::Element) => {
+            to(PointerTarget::Views, Send::Nothing)
+        }
