+    /// Follows one desktop portal motion setting. When the outcome moved, runs the app's callback without `common`
+    /// borrowed, since the callback can call back into the platform.
+    #[cfg_attr(
+        not(all(target_os = "linux", any(feature = "wayland", feature = "x11"))),
+        allow(dead_code)
+    )]
+    pub(crate) fn handle_portal_motion(common: &RefCell<Self>, setting: MotionSetting) {
+        let (before, after) = {
+            let mut common = common.borrow_mut();
+            let before = common.portal_motion.settings();
+            common.portal_motion = common.portal_motion.with(setting);
+            (before, common.portal_motion.settings())
+        };
+        if before == after {
+            return;
+        }
+        let callback = common
+            .borrow_mut()
+            .callbacks
+            .accessibility_display_change
+            .take();
+        if let Some(mut callback) = callback {
+            callback(after);
+            // The callback may have replaced itself.
+            common
+                .borrow_mut()
+                .callbacks
+                .accessibility_display_change
+                .get_or_insert(callback);
+        }
+    }
