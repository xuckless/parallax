diff --git a/gpui-pre-windows/src/native_views.rs b/gpui-pre-windows/src/native_views.rs
new file mode 100644
index 0000000..dd5507a
--- /dev/null
+++ b/gpui-pre-windows/src/native_views.rs
@@ -0,0 +1,223 @@
+//! What DirectComposition shows of a window's native views, decided on plain values so it is tested on any host
+//! (Parallax's `scripts/patch-test.sh` builds this file on its own); `directx_renderer.rs` applies it to the visual
+//! tree. Modelled on Chromium's `ui/gl/dc_layer_tree.cc` (`VisualTree::BuildTree`, `VisualSubtree::Update`): every
+//! view is a clip visual holding a content visual, stacked back to front under GPUI's own swap chain visual, and the
+//! tree is changed and committed only when a frame moves, shows, hides or restacks a view.
+
+use gpui::{Bounds, NativeViewId, PaintNativeView, Rgba, ScaledPixels, WindowBackgroundAppearance};
+
+/// Where one native view's visuals sit, in whole device pixels from the window's top left.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct Placement {
+    /// The content visual's offset: the view's top left, so its content shows 1:1 from there.
+    pub(crate) origin: [f32; 2],
+    /// The clip visual's clip, `[left, top, right, bottom]`: the part of the view its content mask leaves.
+    pub(crate) clip: [f32; 4],
+}
+
+impl Placement {
+    /// `None` when the content mask leaves none of the view.
+    ///
+    /// The bounds are already snapped to device pixels by the element, and the hole is drawn from the same bounds, so
+    /// rounding to whole pixels here puts the visuals exactly where the rasterizer cleared the hole, at any scale.
+    pub(crate) fn new(
+        bounds: Bounds<ScaledPixels>,
+        content_mask: Bounds<ScaledPixels>,
+    ) -> Option<Self> {
+        let visible = bounds.intersect(&content_mask);
+        let edges = |bounds: Bounds<ScaledPixels>| {
+            let corner = bounds.bottom_right();
+            [
+                bounds.origin.x.0.round(),
+                bounds.origin.y.0.round(),
+                corner.x.0.round(),
+                corner.y.0.round(),
+            ]
+        };
+        let clip = edges(visible);
+        if clip[0] >= clip[2] || clip[1] >= clip[3] {
+            return None;
+        }
+        let [x, y, ..] = edges(bounds);
+        Some(Self {
+            origin: [x, y],
+            clip,
+        })
+    }
+}
+
+/// How DXGI composes GPUI's swap chain over what is under it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum AlphaMode {
+    /// Every pixel opaque: DWM skips blending the window.
+    Ignore,
+    /// Pixels blend over what is under them: the native views, or the desktop behind a transparent window.
+    Premultiplied,
+}
+
+impl AlphaMode {
+    /// An opaque window blends only while it shows a native view, so a window without one costs what it did before.
+    pub(crate) fn new(appearance: WindowBackgroundAppearance, shows_native_views: bool) -> Self {
+        // (appearance, shows a view) → mode. Every appearance but Opaque lets the desktop show through.
+        match (appearance, shows_native_views) {
+            (WindowBackgroundAppearance::Opaque, false) => Self::Ignore,
+            (WindowBackgroundAppearance::Opaque, true)
+            | (WindowBackgroundAppearance::Transparent, _)
+            | (WindowBackgroundAppearance::Blurred, _)
+            | (WindowBackgroundAppearance::MicaBackdrop, _)
+            | (WindowBackgroundAppearance::MicaAltBackdrop, _) => Self::Premultiplied,
+        }
+    }
+}
+
+/// What one frame shows of the window's native views.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub(crate) struct Frame {
+    /// The views shown, back to front, each with its placement.
+    pub(crate) views: Vec<(NativeViewId, Placement)>,
+    /// The opaque color under every view, shown where a view's content doesn't reach (its content hasn't caught up
+    /// with a resize yet). `None` for a window whose backdrop is meant to show through, or with no view shown.
+    pub(crate) background: Option<[f32; 3]>,
+}
+
+impl Frame {
+    /// The scene's native views are sorted by draw order and painted once each, so the ones painted later, which
+    /// belong in front, come last. An opaque window shows black under its views unless one asks for a color, the
+    /// view painted last winning, as on macOS.
+    pub(crate) fn new(native_views: &[PaintNativeView], appearance: WindowBackgroundAppearance) -> Self {
+        let views: Vec<_> = native_views
+            .iter()
+            .filter_map(|view| {
+                Placement::new(view.bounds, view.content_mask.bounds).map(|placement| (view.id, placement))
+            })
+            .collect();
+        let background = (appearance == WindowBackgroundAppearance::Opaque && !views.is_empty()).then(|| {
+            let Rgba { r, g, b, .. } = native_views
+                .iter()
+                .rev()
+                .map(|view| Rgba::from(view.background))
+                .find(|color| color.a > 0.)
+                .unwrap_or(Rgba { r: 0., g: 0., b: 0., a: 1. });
+            [r, g, b]
+        });
+        Self { views, background }
+    }
+
+    pub(crate) fn stacking(&self) -> impl Iterator<Item = NativeViewId> + '_ {
+        self.views.iter().map(|(id, _)| *id)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use gpui::{ContentMask, DrawOrder, HitboxId, Hsla, hsla, point, size};
+
+    fn device_bounds(x: f32, y: f32, width: f32, height: f32) -> Bounds<ScaledPixels> {
+        Bounds {
+            origin: point(ScaledPixels(x), ScaledPixels(y)),
+            size: size(ScaledPixels(width), ScaledPixels(height)),
+        }
+    }
+
+    #[test]
+    fn placement_of_a_view() {
+        // (name, bounds, content mask, placement). Extend with a row per layout case DirectComposition must match.
+        let rows: [(&str, [f32; 4], [f32; 4], Option<Placement>); 5] = [
+            (
+                "unclipped view shows whole at its origin",
+                [10., 20., 100., 50.],
+                [0., 0., 800., 600.],
+                Some(Placement { origin: [10., 20.], clip: [10., 20., 110., 70.] }),
+            ),
+            (
+                "content mask clips the view, origin stays",
+                [10., 20., 100., 50.],
+                [0., 40., 60., 600.],
+                Some(Placement { origin: [10., 20.], clip: [10., 40., 60., 70.] }),
+            ),
+            (
+                // At scale 1.25 an element at 9.6 logical px is snapped to device px 12.
+                "1.25 scale: snapped bounds stay on whole pixels",
+                [12., 25., 125., 62.5],
+                [0., 0., 1000., 750.],
+                Some(Placement { origin: [12., 25.], clip: [12., 25., 137., 88.] }),
+            ),
+            ("clipped away entirely is hidden", [10., 20., 100., 50.], [200., 0., 50., 50.], None),
+            ("zero sized is hidden", [10., 20., 0., 50.], [0., 0., 800., 600.], None),
+        ];
+        for (name, [x, y, w, h], [mx, my, mw, mh], expected) in rows {
+            let placement = Placement::new(device_bounds(x, y, w, h), device_bounds(mx, my, mw, mh));
+            assert_eq!(placement, expected, "{name}");
+        }
+    }
+
+    #[test]
+    fn alpha_mode_per_appearance() {
+        // (appearance, shows a native view, mode). One row per WindowBackgroundAppearance variant and view state.
+        let rows = [
+            (WindowBackgroundAppearance::Opaque, false, AlphaMode::Ignore),
+            (WindowBackgroundAppearance::Opaque, true, AlphaMode::Premultiplied),
+            (WindowBackgroundAppearance::Transparent, false, AlphaMode::Premultiplied),
+            (WindowBackgroundAppearance::Transparent, true, AlphaMode::Premultiplied),
+            (WindowBackgroundAppearance::Blurred, false, AlphaMode::Premultiplied),
+            (WindowBackgroundAppearance::MicaBackdrop, false, AlphaMode::Premultiplied),
+            (WindowBackgroundAppearance::MicaAltBackdrop, true, AlphaMode::Premultiplied),
+        ];
+        for (appearance, shows, expected) in rows {
+            assert_eq!(AlphaMode::new(appearance, shows), expected, "{appearance:?}, shows {shows}");
+        }
+    }
+
+    #[test]
+    fn frame_of_a_scene() {
+        let view = |id: u64, x: f32, background: Hsla| PaintNativeView {
+            order: 0 as DrawOrder,
+            id: NativeViewId::for_test(id),
+            hitbox_id: HitboxId::placeholder(),
+            bounds: device_bounds(x, 0., 10., 10.),
+            content_mask: ContentMask { bounds: device_bounds(0., 0., 100., 100.) },
+            background,
+        };
+        let clear = Hsla::transparent_black();
+        let red = hsla(0., 1., 0.5, 1.);
+        let at = |x: f32| Placement { origin: [x, 0.], clip: [x, 0., x + 10., 10.] };
+        // (name, scene views, appearance, frame). Extend with a row per stacking or background rule.
+        let rows = [
+            ("no views, no background", vec![], WindowBackgroundAppearance::Opaque, Frame::default()),
+            (
+                "back to front in paint order, black when no view asks for a color",
+                vec![view(2, 0., clear), view(1, 20., clear)],
+                WindowBackgroundAppearance::Opaque,
+                Frame {
+                    views: vec![(NativeViewId::for_test(2), at(0.)), (NativeViewId::for_test(1), at(20.))],
+                    background: Some([0., 0., 0.]),
+                },
+            ),
+            (
+                "the last view asking for a color wins",
+                vec![view(1, 0., red), view(2, 20., clear)],
+                WindowBackgroundAppearance::Opaque,
+                Frame {
+                    views: vec![(NativeViewId::for_test(1), at(0.)), (NativeViewId::for_test(2), at(20.))],
+                    background: Some([1., 0., 0.]),
+                },
+            ),
+            (
+                "a transparent window keeps its backdrop",
+                vec![view(1, 0., red)],
+                WindowBackgroundAppearance::Transparent,
+                Frame { views: vec![(NativeViewId::for_test(1), at(0.))], background: None },
+            ),
+            (
+                "a clipped-away view is hidden and asks for no background",
+                vec![view(1, 200., red)],
+                WindowBackgroundAppearance::Opaque,
+                Frame::default(),
+            ),
+        ];
+        for (name, views, appearance, expected) in rows {
+            assert_eq!(Frame::new(&views, appearance), expected, "{name}");
+        }
+    }
+}
